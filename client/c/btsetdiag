/* Diagnostic: what the applications see when they read their choices. */
#define _POSIX_C_SOURCE 200809L
#include "btsettings.h"
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

static void dump(const char *path)
{
    FILE *f = fopen(path, "r");
    char line[128];
    if (f == NULL) { printf("  fopen(%s) FAILED\n", path); return; }
    printf("  fopen(%s) ok:\n", path);
    while (fgets(line, sizeof(line), f) != NULL) printf("    [%s]", line);
    printf("\n");
    fclose(f);
}

int main(void)
{
    bt_settings s;
    const char *write = getenv("Choices$Write");
    char path[256];
    printf("Choices$Write = %s\n", write ? write : "(unset)");
    dump("Choices:Bluetooth.Settings");
    if (write != NULL)
    {
        snprintf(path, sizeof(path), "%s.Bluetooth.Settings", write);
        dump(path);
    }
    bt_settings_load(&s);
    printf("loaded: address [%s] name [%s] sound %d connect %d usb %d\n",
           s.address, s.name, s.system_sound, s.connect_at_start,
           s.load_usb_drivers);
    return 0;
}
