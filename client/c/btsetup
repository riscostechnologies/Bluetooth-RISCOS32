#define _POSIX_C_SOURCE 200809L
/*******************************************************************
 * File:        btsetup
 * Purpose:     Configure plug-in (!BTSetup) for the Bluetooth choices.
 *              Configure starts it with "-openat x y" and later sends
 *              Message_OpenConfigWindow / Message_PlugInQuit.
 ******************************************************************/
#include "btsettings.h"
#include "btwimp.h"
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define TASK_NAME "Bluetooth Setup"
#define WINDOW_WIDTH 1000
#define WINDOW_HEIGHT 780

enum
{
    I_ADDRESS_LABEL, I_ADDRESS, I_ADDRESS_HINT,
    I_PIN_LABEL, I_PIN,
    I_SOUND, I_START, I_CONNECT, I_USB,
    I_NOTE,
    I_DEFAULT, I_CANCEL, I_SET,
    I_LOGO, I_TITLE, I_H_SPEAKER, I_H_START, I_H_SOUND, I_H_ADVANCED,
    I_COUNT
};

static int window;

static void create_window(void)
{
    static bt_icon_spec icons[I_COUNT];
    const unsigned int grey = (bt_flags_label() & ~(15u << 24)) | (5u << 24);
    memset(icons, 0, sizeof(icons));
    icons[I_LOGO] = (bt_icon_spec){ 24, -100, 104, -20, bt_flags_label() | 0x2u,
        "", "S!btsetup", 4 };
    icons[I_TITLE] = (bt_icon_spec){ 124, -62, 960, -20, bt_flags_label(),
        "Bluetooth settings", NULL, 0 };
    icons[I_NOTE] = (bt_icon_spec){ 124, -100, 984, -66, grey,
        "Pair and connect devices from the Bluetooth icon on the icon bar.",
        NULL, 0 };
    icons[I_H_SPEAKER] = (bt_icon_spec){ 16, -152, 984, -116, grey, "Speaker",
        NULL, 0 };
    icons[I_ADDRESS_LABEL] = (bt_icon_spec){ 32, -212, 270, -160,
        bt_flags_label(), "Reconnects at start-up", NULL, 0 };
    icons[I_ADDRESS] = (bt_icon_spec){ 280, -212, 570, -160, bt_flags_label(),
        "", NULL, 18 };
    icons[I_ADDRESS_HINT] = (bt_icon_spec){ 580, -212, 984, -160, bt_flags_label(),
        "", NULL, 64 };
    icons[I_H_START] = (bt_icon_spec){ 16, -268, 984, -232, grey,
        "When the computer starts", NULL, 0 };
    icons[I_START] = (bt_icon_spec){ 32, -328, 984, -276, bt_flags_option(),
        "Start Bluetooth", "Soptoff,opton", 0 };
    icons[I_CONNECT] = (bt_icon_spec){ 32, -384, 984, -332, bt_flags_option(),
        "Reconnect my speaker and other paired devices", "Soptoff,opton", 0 };
    icons[I_H_SOUND] = (bt_icon_spec){ 16, -440, 984, -404, grey, "Sound", NULL, 0 };
    icons[I_SOUND] = (bt_icon_spec){ 32, -500, 984, -448, bt_flags_option(),
        "Play the computer's sound through the speaker", "Soptoff,opton", 0 };
    icons[I_H_ADVANCED] = (bt_icon_spec){ 16, -556, 984, -520, grey, "Advanced",
        NULL, 0 };
    icons[I_PIN_LABEL] = (bt_icon_spec){ 32, -616, 420, -564, bt_flags_label(),
        "PIN for older devices", NULL, 0 };
    icons[I_PIN] = (bt_icon_spec){ 430, -616, 640, -564, bt_flags_writable(),
        "", "Kta;A0-9;Pptr_write", 17 };
    icons[I_USB] = (bt_icon_spec){ 32, -672, 984, -620, bt_flags_option(),
        "Load the USB audio drivers at start-up (Raspberry Pi)", "Soptoff,opton", 0 };
    icons[I_DEFAULT] = (bt_icon_spec){ 16, -764, 216, -704, bt_flags_action(),
        "Default", "R5,3", 0 };
    icons[I_CANCEL] = (bt_icon_spec){ 572, -764, 772, -704, bt_flags_action(),
        "Cancel", "R5,3", 0 };
    icons[I_SET] = (bt_icon_spec){ 784, -768, 984, -700, bt_flags_action(),
        "Set", "R6,3", 0 };
    window = bt_window_create("Bluetooth settings", WINDOW_WIDTH,
                              WINDOW_HEIGHT, icons, I_COUNT, 1);
}

static void show(const bt_settings *settings, int start_with_desktop,
                 int usb_at_start)
{
    bt_icon_set_text(window, I_ADDRESS, settings->address);
    bt_icon_set_text(window, I_ADDRESS_HINT,
                     settings->name[0] ? settings->name :
                     settings->address[0] ? "" :
                     "None yet: connect a speaker in the Devices window");
    bt_icon_set_text(window, I_PIN, settings->pin);
    bt_icon_set_selected(window, I_SOUND, settings->system_sound);
    bt_icon_set_selected(window, I_START, start_with_desktop);
    bt_icon_set_selected(window, I_CONNECT, settings->connect_at_start);
    bt_icon_set_selected(window, I_USB, usb_at_start);
}

static void load_into_window(void)
{
    bt_settings settings;
    bt_settings_load(&settings);
    show(&settings, bt_settings_start_with_desktop(),
         settings.load_usb_drivers);
}

static int save_from_window(void)
{
    bt_settings settings;
    const char *address = bt_icon_text(window, I_ADDRESS);
    bt_settings_load(&settings); /* keep anything the window lacks */
    if (!bt_settings_address_valid(address))
    {
        bt_report("The headset address must look like 01:23:45:67:89:AB, or be empty.", 1);
        bt_caret_to(window, I_ADDRESS);
        return 0;
    }
    if (strcmp(settings.address, address) != 0) settings.name[0] = '\0';
    strncpy(settings.address, address, sizeof(settings.address) - 1);
    settings.address[sizeof(settings.address) - 1] = '\0';
    strncpy(settings.pin, bt_icon_text(window, I_PIN), sizeof(settings.pin) - 1);
    settings.pin[sizeof(settings.pin) - 1] = '\0';
    if (settings.pin[0] == '\0') strcpy(settings.pin, "0000");
    settings.system_sound = bt_icon_selected(window, I_SOUND);
    settings.connect_at_start = bt_icon_selected(window, I_CONNECT);
    settings.load_usb_drivers = bt_icon_selected(window, I_USB);
    if (!bt_settings_save(&settings))
    {
        bt_report("Could not save the Bluetooth choices.", 1);
        return 0;
    }
    if (!bt_settings_set_start_with_desktop(bt_icon_selected(window, I_START)))
    {
        bt_report("Could not change the desktop start-up entry.", 1);
        return 0;
    }
    if (!bt_settings_set_load_usb_at_start(settings.load_usb_drivers))
    {
        bt_report("Could not change the USB driver start-up entry.", 1);
        return 0;
    }
    return 1;
}

static int on_click(const int *block)
{
    int icon = block[4], buttons = block[2];
    if (block[3] != window) return 0;
    switch (icon)
    {
    case I_SOUND:
    case I_START:
    case I_CONNECT:
    case I_USB:
        bt_icon_set_selected(window, icon, !bt_icon_selected(window, icon));
        break;
    case I_DEFAULT:
    {
        bt_settings settings;
        bt_settings_default(&settings);
        show(&settings, 0, 0);
        break;
    }
    case I_CANCEL:
        if (buttons == BUTTON_ADJUST) load_into_window();
        else return 1;
        break;
    case I_SET:
        if (save_from_window() && buttons != BUTTON_ADJUST) return 1;
        break;
    default: break;
    }
    return 0;
}

int main(int argc, char **argv)
{
    int block[64];
    int done = 0;
    if (!bt_wimp_initialise(TASK_NAME)) return 1;
    create_window();
    if (window == 0) return 1;
    load_into_window();
    if (argc >= 4 && strcmp(argv[1], "-openat") == 0)
        bt_window_open_at(window, atoi(argv[2]), atoi(argv[3]));
    else
        bt_window_open_centred(window);
    bt_caret_to(window, I_ADDRESS);
    while (!done)
    {
        switch (bt_wimp_poll(-1, block))
        {
        case WIMP_OPEN: bt_window_reopen(block); break;
        case WIMP_CLOSE: done = 1; break;
        case WIMP_CLICK: done = on_click(block); break;
        case WIMP_KEY:
            if (block[6] == 13) done = save_from_window();
            else if (block[6] == 27) done = 1;
            else
            {
                _kernel_swi_regs regs;
                memset(&regs, 0, sizeof(regs));
                regs.r[0] = block[6];
                (void)_kernel_swi(0x400dc /* Wimp_ProcessKey */, &regs, &regs);
            }
            break;
        case WIMP_MESSAGE:
        case WIMP_MESSAGE_RECORDED:
            if (block[4] == MESSAGE_QUIT || block[4] == MESSAGE_PLUGIN_QUIT)
                done = 1;
            else if (block[4] == MESSAGE_OPEN_CONFIG_WINDOW)
            {
                int state[9];
                _kernel_swi_regs regs;
                state[0] = window;
                memset(&regs, 0, sizeof(regs));
                regs.r[1] = (int)state;
                if (_kernel_swi(0x400cb /* Wimp_GetWindowState */, &regs,
                                &regs) == NULL)
                {
                    state[7] = -1; /* bring to the front */
                    bt_window_reopen(state);
                }
            }
            break;
        default: break;
        }
    }
    bt_wimp_finalise();
    return 0;
}
