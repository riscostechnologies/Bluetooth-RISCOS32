static void on_menu(const int *block)
{
    _kernel_swi_regs regs;
    int pointer[5], index;
    if (menu_context == 1)
    {
        device_menu_choice(block[0]);
        return;
    }
    switch (block[0])
    {
    case M_DEVICES: open_devices(); break;
    case M_CONNECT:
    {
        device d;
        unsigned char saved[6];
        parse_saved(saved);
        memset(&d, 0, sizeof(d));
        memcpy(d.address, saved, 6);
        d.flags = DEV_AUDIO_SINK;
        for (index = 0; index < device_count; ++index)
            if (memcmp(devices[index].address, saved, 6) == 0)
                d = devices[index];
        d.flags |= DEV_AUDIO_SINK;
        d.flags &= ~(unsigned int)(DEV_HID | DEV_LE);
        connect_device(&d, 0);
        break;
    }
    case M_DISCONNECT:
        for (index = 0; index < device_count; ++index)
            if (devices[index].link_state != 0)
                disconnect_device(devices[index].address);
        break;
    case M_CONFIGURE: open_configure(); break;
    case M_HELP: bt_start_task("Filer_Run <Bluetooth$Dir>.!Help"); break;
    case M_QUIT: begin_quit(); break;
    default: break;
    }
    memset(&regs, 0, sizeof(regs));
    regs.r[1] = (int)pointer;
    if (_kernel_swi(Wimp_GetPointerInfo, &regs, &regs) == NULL &&
        (pointer[2] & BUTTON_ADJUST) && current_menu != NULL && !quitting)
        open_menu(pointer[0]);
}

static void on_help(int *message)
{
    char reply_text[236];
    int reply[64];
    if (message[8] == -2 && message[9] == iconbar_icon)
        snprintf(reply_text, sizeof(reply_text),
                 "This is the Bluetooth icon.|MClick SELECT to see and connect "
                 "devices, ADJUST to configure Bluetooth.|M%s", status_line);
    else if (devices_window != 0 && message[8] == devices_window)
    {
        int icon = message[9];
        int part = icon >= D_ROW0 ? (icon - D_ROW0) % ROW_ICONS : -1;
        const char *text =
            icon == D_SCAN ? "Click to look for devices for 10 seconds. Put the device in pairing mode first." :
            icon == D_SETTINGS ? "Click to open the Bluetooth settings." :
            icon == D_HELP ? "Click to read the help." :
            part == R_ACTION ? "Click to connect or disconnect this device. A new device is paired first." :
            part >= 0 ? "A Bluetooth device. Click MENU on it to disconnect it or make it forget its pairing." :
            "Bluetooth devices: those connected first, then paired ones, then what the scan found.";
        snprintf(reply_text, sizeof(reply_text), "%s", text);
    }
    else if (pair_window != 0 && message[8] == pair_window)
        snprintf(reply_text, sizeof(reply_text),
                 "Answer Yes when the number on the device matches; No to refuse pairing.");
    else
        return;
    memset(reply, 0, sizeof(reply));
    strcpy((char *)(reply + 5), reply_text);
    reply[0] = (int)((20 + strlen(reply_text) + 4) & ~3u);
    reply[3] = message[2];
    reply[4] = MESSAGE_HELP_REPLY;
    bt_send_message(WIMP_MESSAGE, reply, message[1]);
}

static void on_click(const int *block)
{
    if (devices_window != 0 && block[3] == devices_window)
    {
        on_devices_click(block);
        return;
    }
    if (pair_window != 0 && block[3] == pair_window)
    {
        pair_click(block);
        return;
    }
    if (block[3] != -2) return;
    if (block[2] == BUTTON_MENU) open_menu(block[0]);
    else if (block[2] == BUTTON_SELECT) open_devices();
    else if (block[2] == BUTTON_ADJUST) open_configure();
}

int main(int argc, char **argv)
{
    int block[64];
    int done = 0, index;
    (void)argc;
    (void)argv;
    if (!bt_wimp_initialise(TASK_NAME)) return 1;
    for (index = 0; index < LIST_ROWS; ++index) row_device[index] = -1;
    bt_settings_load(&settings);
    iconbar_icon = bt_iconbar_create("bt_busy");
    create_info_window();
    create_devices_window();
    create_pair_window();
    /* Start straight away when the drivers are ready (or may be loaded
     * without asking); otherwise wait until the user asks. */
    if (bt_usb_stack_ready() || settings.load_usb_drivers)
        if (!start_core(0))
        {
            /* At boot the adapter may still be enumerating: try again
             * every 3 s for a minute rather than wait for a click. */
            boot_tries = 20;
            boot_retry_at = bt_monotonic() + 300;
        }
    poll_core();
    while (!done)
    {
        int reason = bt_wimp_poll(quitting ? 5 : 25, block);
        switch (reason)
        {
        case WIMP_NULL:
            poll_core();
            if (scan_when_ready && core_state == CORE_READY)
            {
                scan_when_ready = 0;
                start_scan();
            }
            break;
        case WIMP_OPEN: bt_window_reopen(block); break;
        case WIMP_CLOSE:
            if (pair_window != 0 && block[0] == pair_window) pair_reply(0);
            bt_window_close(block[0]);
            break;
        case WIMP_CLICK: on_click(block); break;
        case 8:   /* Key_Pressed: none of ours, so pass it on (hotkeys) */
        {
            _kernel_swi_regs key;
            memset(&key, 0, sizeof(key));
            key.r[0] = block[6];
            (void)_kernel_swi(0x400DC, &key, &key);   /* Wimp_ProcessKey */
            break;
        }
        case WIMP_MENU: on_menu(block); break;
        case WIMP_MESSAGE:
        case WIMP_MESSAGE_RECORDED:
            if (block[4] == MESSAGE_TASK_INITIALISE)
            {
                /* A second copy would fight this one for the core: the
                 * newcomer is asked to go away. */
                const char *name = (const char *)(block + 7);
                if (block[1] != bt_wimp_task() &&
                    strcmp(name, TASK_NAME) == 0)
                {
                    int quit[5];
                    memset(quit, 0, sizeof(quit));
                    quit[0] = 20;
                    quit[4] = MESSAGE_QUIT;
                    bt_send_message(WIMP_MESSAGE, quit, block[1]);
                }
            }
            else if (block[4] == MESSAGE_QUIT && !quitting) begin_quit();
            else if (block[4] == MESSAGE_HELP_REQUEST) on_help(block);
            break;
        default: break;
        }
        if (quitting && (core_state == CORE_OFF ||
                         bt_monotonic() - quit_started > 600))
            done = 1;
    }
    bt_wimp_finalise();
    return 0;
}
