static const char *state_label(const device *d, int *colour)
{
    const char *s = state_text(d);
    *colour = COL_GREY;
    if (strcmp(s, "connected") == 0) { *colour = COL_GREEN; return "Connected"; }
    if (strcmp(s, "playing") == 0) { *colour = COL_GREEN; return "Playing"; }
    if (strcmp(s, "paused") == 0) { *colour = COL_GREEN; return "Paused"; }
    if (strcmp(s, "setting up") == 0) { *colour = COL_ORANGE; return "Setting up"; }
    if (strcmp(s, "connecting") == 0) { *colour = COL_ORANGE; return "Connecting"; }
    if (strcmp(s, "disconnecting") == 0) { *colour = COL_ORANGE; return "Disconnecting"; }
    if (strcmp(s, "paired") == 0) return "Paired";
    return "Not paired";
}

/* Connected devices first, then paired ones, then what the scan found. */
static int list_order(int *order)
{
    int pass, i, n = 0;
    for (pass = 0; pass < 3; ++pass)
        for (i = 0; i < device_count; ++i)
        {
            unsigned int f = devices[i].flags;
            int group = devices[i].link_state != 0 ? 0 :
                        (f & DEV_PAIRED) ? 1 : 2;
            if (group == pass) order[n++] = i;
        }
    return n;
}

static void put_text(int icon, char *shown_text, size_t size, const char *text)
{
    if (strncmp(shown_text, text, size - 1) == 0 &&
        strlen(text) < size) return;
    strncpy(shown_text, text, size - 1);
    shown_text[size - 1] = '\0';
    bt_icon_set_text(devices_window, icon, text);
}

static void refresh_devices_window(void)
{
    int order[MAX_DEVICES], n, row, show_empty;
    char text[100];
    if (devices_window == 0) return;
    put_text(D_STATUS, shown_status, sizeof(shown_status), status_line);
    put_text(D_SCAN, shown_scan, sizeof(shown_scan),
             scanning ? "Scanning..." : "Scan for devices");
    bt_icon_set_shaded(devices_window, D_SCAN, scanning);
    n = list_order(order);
    show_empty = n == 0;
    if (show_empty != shown_empty)
    {
        shown_empty = show_empty;
        bt_icon_set_visible(devices_window, D_EMPTY, show_empty);
        bt_icon_set_visible(devices_window, D_HINT, show_empty);
    }
    if (show_empty)
        put_text(D_HINT, shown_hint, sizeof(shown_hint),
                 scanning ? "Searching for devices..." :
                 "Put your speaker, mouse or keyboard in pairing mode, "
                 "then click Scan for devices.");
    for (row = 0; row < LIST_ROWS; ++row)
    {
        struct row_shown *w = shown + row;
        int visible = row < n;
        if (!visible)
        {
            row_device[row] = -1;
            if (w->visible)
            {
                int part;
                for (part = 0; part < ROW_ICONS; ++part)
                    bt_icon_set_visible(devices_window, ROW_ICON(row, part), 0);
                w->visible = 0;
            }
            continue;
        }
        {
            const device *d = devices + order[row];
            char fallback[20], address[18], badge[20], action[24];
            const char *type = type_text(d->flags), *label;
            int colour, busy = d->link_state == 1 || d->link_state == 3;
            int connected = d->link_state == 2;
            row_device[row] = order[row];
            if (!w->visible)
            {
                int part;
                for (part = 0; part < ROW_ICONS; ++part)
                    bt_icon_set_visible(devices_window, ROW_ICON(row, part), 1);
                w->visible = 1;
                w->name[0] = w->detail[0] = w->state[0] = w->action[0] = '\0';
                w->badge[0] = '\0';
                w->fg = -1;
                w->shaded = -1;
            }
            snprintf(badge, sizeof(badge), "Sdv_%s_%c", badge_kind(d),
                     connected ? 'b' : 'g');
            if (strcmp(badge, w->badge) != 0)
            {
                strcpy(w->badge, badge);
                strcpy(row_sprite[row], badge);
                bt_icon_redraw(devices_window, ROW_ICON(row, R_BADGE));
            }
            put_text(ROW_ICON(row, R_NAME), w->name, sizeof(w->name),
                     device_name(d, fallback));
            format_address(d->address, address);
            snprintf(text, sizeof(text), "%c%s%s   %s", type[0] - 32 * (type[0] >= 'a'),
                     type + 1, (d->flags & DEV_LE) ? ", Low Energy" : "",
                     address);
            if (d->battery <= 100)
            {
                size_t len = strlen(text);
                snprintf(text + len, sizeof(text) - len, "   Battery %d%%",
                         d->battery);
            }
            put_text(ROW_ICON(row, R_DETAIL), w->detail, sizeof(w->detail), text);
            label = state_label(d, &colour);
            put_text(ROW_ICON(row, R_STATE), w->state, sizeof(w->state), label);
            if (w->fg != colour)
            {
                w->fg = colour;
                bt_icon_set_fg(devices_window, ROW_ICON(row, R_STATE), colour);
            }
            strcpy(action, connected ? "Disconnect" : busy ? "Please wait" :
                   (d->flags & DEV_PAIRED) ? "Connect" : "Pair");
            put_text(ROW_ICON(row, R_ACTION), w->action, sizeof(w->action), action);
            {
                int shade = busy || (!connected && core_state != CORE_READY);
                if (w->shaded != shade)
                {
                    w->shaded = shade;
                    bt_icon_set_shaded(devices_window, ROW_ICON(row, R_ACTION), shade);
                }
            }
        }
    }
}

static void start_scan(void)
{
    _kernel_swi_regs regs;
    if (core_state == CORE_OFF)
    {
        (void)start_core(1);
        return;          /* the scan starts once the adapter is ready */
    }
    reorder_devices();
    memset(&regs, 0, sizeof(regs));
    regs.r[1] = 10;
    if (call(SWI_SCAN, &regs) == NULL) scanning = 1;
    last_generation = 0xffffffffu;
}

static int scan_when_ready;

static void open_devices(void)
{
    if (devices_window == 0) return;
    refresh_devices_window();
    bt_window_open_centred(devices_window);
    if (!scanning) scan_when_ready = 1;
    if (core_state == CORE_OFF) (void)start_core(1);
}

static int *current_menu;
static void open_configure(void);

/* The one obvious thing for a device: connect it, pairing first if it is
 * new, or let it go. */
static void primary_action(const device *d)
{
    if (d->link_state == 2) disconnect_device(d->address);
    else if (d->link_state == 0) connect_device(d, 0);
}

static int menu_context, menu_device = -1;     /* 1: a device's menu */

static void device_menu(int index, const int *click)
{
    static char title[40], first[16];
    bt_menu_item items[2];
    const device *d = devices + index;
    char fallback[20];
    snprintf(title, sizeof(title), "%.30s", device_name(d, fallback));
    strcpy(first, d->link_state == 2 ? "Disconnect" :
                  (d->flags & DEV_PAIRED) ? "Connect" : "Pair");
    memset(items, 0, sizeof(items));
    items[0].text = first;
    items[0].shaded = d->link_state == 1 || d->link_state == 3 ||
                      core_state != CORE_READY;
    items[1].text = "Forget";
    items[1].shaded = !(d->flags & DEV_PAIRED);
    menu_context = 1;
    menu_device = index;
    current_menu = bt_menu_build(title, items, 2);
    bt_menu_open(current_menu, click[0] - 64, click[1]);
}

static void device_menu_choice(int item)
{
    int index = menu_device;
    menu_context = 0;
    menu_device = -1;
    if (index < 0 || index >= device_count) return;
    if (item == 0) primary_action(devices + index);
    else if (item == 1 &&
             bt_ask("Forget this device? It will need to pair again.",
                    "Forget,Keep") == 0)
        forget_device(devices[index].address);
    last_generation = 0xffffffffu;
    poll_core();
}

/* Which list row a click was on, from the pointer position, so that a click
 * on a plain text label counts as well as one on a button: -1 for none. */
static int row_at(const int *click)
{
    _kernel_swi_regs regs;
    int state[9], work_y, row;
    state[0] = devices_window;
    memset(&regs, 0, sizeof(regs));
    regs.r[1] = (int)state;
    if (_kernel_swi(Wimp_GetWindowState, &regs, &regs) != NULL) return -1;
    work_y = click[1] - (state[4] - state[6]);
    if (work_y > LIST_TOP) return -1;
    row = (LIST_TOP - work_y) / ROW_HEIGHT;
    return row < LIST_ROWS ? row : -1;
}

static void on_devices_click(const int *block)
{
    int icon = block[4];
    if (block[2] == BUTTON_MENU)
    {
        int row = row_at(block);
        if (row >= 0 && row_device[row] >= 0) device_menu(row_device[row], block);
        return;
    }
    if (icon == D_SCAN)
    {
        if (core_state == CORE_READY) start_scan();
        else
        {
            scan_when_ready = 1;
            if (core_state == CORE_OFF) (void)start_core(1);
        }
    }
    else if (icon == D_SETTINGS) open_configure();
    else if (icon == D_HELP) bt_start_task("Filer_Run <Bluetooth$Dir>.!Help");
    else if (icon >= D_ROW0)
    {
        int row = (icon - D_ROW0) / ROW_ICONS, part = (icon - D_ROW0) % ROW_ICONS;
        int index = row < LIST_ROWS ? row_device[row] : -1;
        if (index < 0) return;
        if (block[2] == BUTTON_MENU) device_menu(index, block);
        else if (part == R_ACTION) primary_action(devices + index);
    }
    last_generation = 0xffffffffu;
    poll_core();
}

