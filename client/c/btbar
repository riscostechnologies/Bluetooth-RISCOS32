#define DEVICES_WIDTH 1000
#define ROW_HEIGHT 96
#define LIST_TOP -150
#define COL_GREY 5
#define COL_GREEN 13
#define COL_ORANGE 14

/* Which badge a device wears. */
static const char *badge_kind(const device *d)
{
    if (d->flags & DEV_KEYBOARD) return "kbd";
    if (d->flags & DEV_MOUSE) return "mouse";
    if (d->flags & DEV_HID) return "pad";
    if ((d->flags & DEV_HANDSFREE) && !(d->flags & DEV_AUDIO_SINK)) return "hdst";
    if (d->flags & DEV_AUDIO_SINK) return "spk";
    return "other";
}

/* The sprite validation strings the badge icons point at, rewritten in
 * place when a device's kind or state changes. */
static char row_sprite[LIST_ROWS][20];
static int row_device[LIST_ROWS];

/* What each row shows now, so the Wimp is only touched when it changes. */
static struct row_shown
{
    char name[64], detail[96], state[24], action[24], badge[20];
    int fg, shaded, visible;
} shown[LIST_ROWS];
static char shown_status[80], shown_scan[24], shown_hint[100];
static int shown_empty = -1;

