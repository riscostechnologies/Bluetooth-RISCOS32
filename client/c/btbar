static void create_info_window(void)
{
    static const bt_icon_spec icons[] = {
        { 16, -56, 180, -12, 0, "Name", NULL, 0 },
        { 190, -56, 700, -12, 0, "Bluetooth", NULL, 0 },
        { 16, -104, 180, -60, 0, "Purpose", NULL, 0 },
        { 190, -104, 700, -60, 0, "Speakers, keyboards and mice", NULL, 0 },
        { 16, -152, 180, -108, 0, "Author", NULL, 0 },
        { 190, -152, 700, -108, 0, "BluetoothVoice project", NULL, 0 },
        { 16, -200, 180, -156, 0, "Version", NULL, 0 },
        { 190, -200, 700, -156, 0, VERSION_TEXT, NULL, 0 },
        { 16, -248, 180, -204, 0, "Status", NULL, 0 },
        { 190, -248, 1000, -204, 0, "", NULL, 96 },
    };
    bt_icon_spec copy[sizeof(icons) / sizeof(icons[0])];
    size_t index;
    for (index = 0; index < sizeof(icons) / sizeof(icons[0]); ++index)
    {
        copy[index] = icons[index];
        copy[index].flags = index % 2 == 0 ? bt_flags_label() | 0x200u
                                           : bt_flags_writable() & ~(15u << 12);
    }
    info_window = bt_window_create("About this program", 1016, 264, copy,
                                   (int)(sizeof(copy) / sizeof(copy[0])), 0);
}

#define DEVICES_WIDTH 1300
#define ROW_HEIGHT 48
#define LIST_TOP -72

static void create_devices_window(void)
{
    bt_icon_spec icons[D_COUNT];
    int row, list_bottom = LIST_TOP - LIST_ROWS * ROW_HEIGHT;
    int height = -list_bottom + 100;
    unsigned int row_flags = 0x1u | 0x4u | 0x10u | 0x20u | 0x100u |
                             (11u << 12) | (1u << 16) | (7u << 24);
    memset(icons, 0, sizeof(icons));
    icons[D_STATUS] = (bt_icon_spec){ 16, -60, DEVICES_WIDTH - 16, -12,
        bt_flags_label(), "", NULL, 80 };
    for (row = 0; row < LIST_ROWS; ++row)
        icons[D_ROW0 + row] = (bt_icon_spec){
            16, LIST_TOP - (row + 1) * ROW_HEIGHT + 4,
            DEVICES_WIDTH - 16, LIST_TOP - row * ROW_HEIGHT,
            row_flags | ICON_SHADED, "", NULL, 128 };
    icons[D_SCAN] = (bt_icon_spec){ 16, list_bottom - 76, 216,
        list_bottom - 16, bt_flags_action(), "Scan", "R5,3", 0 };
    icons[D_FORGET] = (bt_icon_spec){ 228, list_bottom - 76, 428,
        list_bottom - 16, bt_flags_action(), "Forget", "R5,3", 0 };
    icons[D_DISCONNECT] = (bt_icon_spec){ 800, list_bottom - 76, 1060,
        list_bottom - 16, bt_flags_action(), "Disconnect", "R5,3", 0 };
    icons[D_CONNECT] = (bt_icon_spec){ 1072, list_bottom - 80,
        DEVICES_WIDTH - 16, list_bottom - 12, bt_flags_action(), "Connect",
        "R6,3", 0 };
    devices_window = bt_window_create("Bluetooth devices", DEVICES_WIDTH,
                                      height, icons, D_COUNT, 1);
}

static int selected_device(void)
{
    int row;
    for (row = 0; row < LIST_ROWS; ++row)
        if (row_device[row] >= 0 &&
            bt_icon_selected(devices_window, D_ROW0 + row))
            return row_device[row];
    return -1;
}

static void refresh_devices_window(void)
{
    char text[128], name[20], address[18];
    int row, chosen;
    if (devices_window == 0) return;
    bt_icon_set_text(devices_window, D_STATUS, status_line);
    chosen = selected_device();
    if (chosen >= 0)
    {
        memcpy(selected_address, devices[chosen].address, 6);
        have_selection = 1;
    }
    for (row = 0; row < LIST_ROWS; ++row)
    {
        device *d;
        if (row >= device_count)
        {
            row_device[row] = -1;
            bt_icon_set_text(devices_window, D_ROW0 + row, "");
            bt_icon_set_selected(devices_window, D_ROW0 + row, 0);
            bt_icon_set_shaded(devices_window, D_ROW0 + row, 1);
            continue;
        }
        d = devices + row;
        row_device[row] = row;
        format_address(d->address, address);
        snprintf(text, sizeof(text), "%.36s   %s%s   %s   %s",
                 device_name(d, name), (d->flags & DEV_LE) ? "LE " : "",
                 type_text(d->flags), address, state_text(d));
        bt_icon_set_text(devices_window, D_ROW0 + row, text);
        bt_icon_set_shaded(devices_window, D_ROW0 + row, 0);
        bt_icon_set_selected(devices_window, D_ROW0 + row,
                             have_selection &&
                             memcmp(selected_address, d->address, 6) == 0);
    }
    bt_icon_set_shaded(devices_window, D_SCAN, scanning);
    /* Only the buttons that would do something are live. */
    chosen = have_selection ? -1 : chosen;
    for (row = 0; row < device_count; ++row)
        if (have_selection &&
            memcmp(selected_address, devices[row].address, 6) == 0)
            chosen = row;
    {
        int connected = chosen >= 0 && devices[chosen].link_state != 0;
        int paired = chosen >= 0 &&
                     (devices[chosen].flags & DEV_PAIRED) != 0;
        bt_icon_set_shaded(devices_window, D_CONNECT,
                           chosen < 0 || connected || core_state != CORE_READY);
        bt_icon_set_shaded(devices_window, D_DISCONNECT, !connected);
        bt_icon_set_shaded(devices_window, D_FORGET, !paired);
    }
}

static void start_scan(void)
{
    _kernel_swi_regs regs;
    if (core_state == CORE_OFF)
    {
        (void)start_core(1);
        return;          /* the scan starts once the adapter is ready */
    }
    reorder_devices();
    memset(&regs, 0, sizeof(regs));
    regs.r[1] = 10;
    if (call(SWI_SCAN, &regs) == NULL) scanning = 1;
    last_generation = 0xffffffffu;
}

static int scan_when_ready;

static void open_devices(void)
{
    if (devices_window == 0) return;
    refresh_devices_window();
    bt_window_open_centred(devices_window);
    if (!scanning) scan_when_ready = 1;
    if (core_state == CORE_OFF) (void)start_core(1);
}

static void on_devices_click(const int *block)
{
    int icon = block[4], chosen = selected_device();
    switch (icon)
    {
    case D_SCAN:
        if (core_state == CORE_READY) start_scan();
        else
        {
            scan_when_ready = 1;
            if (core_state == CORE_OFF) (void)start_core(1);
        }
        break;
    case D_CONNECT:
        if (chosen < 0)
        {
            strcpy(problem_note, "Choose a device in the list first");
            problem_note_until = bt_monotonic() + 500;
        }
        else connect_device(&devices[chosen], 0);
        break;
    case D_DISCONNECT:
        if (chosen >= 0) disconnect_device(devices[chosen].address);
        break;
    case D_FORGET:
        if (chosen >= 0 &&
            bt_ask("Forget this device? It will need to pair again.",
                   "Forget,Keep") == 0)
            forget_device(devices[chosen].address);
        break;
    default:
        break;
    }
    last_generation = 0xffffffffu;
    poll_core();
}

static void refresh_info(void)
{
    if (info_window != 0) bt_icon_set_text(info_window, 9, status_line);
}

/* ---- icon bar ------------------------------------------------- */

static int *current_menu;

static void open_menu(int x)
{
    bt_menu_item items[M_COUNT];
    static char status_item[64], connect_item[64];
    bt_settings_load(&settings);
    snprintf(status_item, sizeof(status_item), "%.44s", status_line);
    if (settings.address[0] != '\0')
        snprintf(connect_item, sizeof(connect_item), "Connect %.30s",
                 settings.name[0] ? settings.name : settings.address);
    else
        strcpy(connect_item, "Connect speaker");
    memset(items, 0, sizeof(items));
    items[M_STATUS].text = status_item;
    items[M_STATUS].shaded = 1;
    items[M_STATUS].dotted = 1;
    items[M_INFO].text = "Info";
    items[M_INFO].submenu = info_window;
    items[M_DEVICES].text = "Devices...";
    items[M_CONNECT].text = connect_item;
    items[M_CONNECT].shaded = settings.address[0] == '\0' ||
                              core_state != CORE_READY;
    items[M_DISCONNECT].text = "Disconnect all";
    items[M_DISCONNECT].dotted = 1;
    items[M_CONFIGURE].text = "Configure...";
    items[M_HELP].text = "Help...";
    items[M_QUIT].text = "Quit";
    refresh_info();
    current_menu = bt_menu_build("Bluetooth", items, M_COUNT);
    bt_menu_open(current_menu, x - 64, 96 + 44 * M_COUNT);
}

static void open_configure(void)
{
    bt_start_task("Filer_Run BootResources:Configure.!BTSetup");
}

static void begin_quit(void)
{
    quitting = 1;
    quit_started = bt_monotonic();
    if (core_state != CORE_OFF) save_keys();
    stop_core();
}

static void on_menu(const int *block)
{
    _kernel_swi_regs regs;
    int pointer[5], index;
    switch (block[0])
    {
    case M_DEVICES: open_devices(); break;
    case M_CONNECT:
    {
        device d;
        unsigned char saved[6];
        parse_saved(saved);
        memset(&d, 0, sizeof(d));
        memcpy(d.address, saved, 6);
        d.flags = DEV_AUDIO_SINK;
        for (index = 0; index < device_count; ++index)
            if (memcmp(devices[index].address, saved, 6) == 0)
                d = devices[index];
        d.flags |= DEV_AUDIO_SINK;
        d.flags &= ~(unsigned int)(DEV_HID | DEV_LE);
        connect_device(&d, 0);
        break;
    }
    case M_DISCONNECT:
        for (index = 0; index < device_count; ++index)
            if (devices[index].link_state != 0)
                disconnect_device(devices[index].address);
        break;
    case M_CONFIGURE: open_configure(); break;
    case M_HELP: bt_start_task("Filer_Run <Bluetooth$Dir>.!Help"); break;
    case M_QUIT: begin_quit(); break;
    default: break;
    }
    memset(&regs, 0, sizeof(regs));
    regs.r[1] = (int)pointer;
    if (_kernel_swi(Wimp_GetPointerInfo, &regs, &regs) == NULL &&
        (pointer[2] & BUTTON_ADJUST) && current_menu != NULL && !quitting)
        open_menu(pointer[0]);
}

static void on_help(int *message)
{
    char reply_text[236];
    int reply[64];
    if (message[8] == -2 && message[9] == iconbar_icon)
        snprintf(reply_text, sizeof(reply_text),
                 "This is the Bluetooth icon.|MClick SELECT to see and connect "
                 "devices, ADJUST to configure Bluetooth.|M%s", status_line);
    else if (devices_window != 0 && message[8] == devices_window)
    {
        int icon = message[9];
        const char *text =
            icon == D_SCAN ? "Click to look for devices for 10 seconds. Put the device in pairing mode first." :
            icon == D_CONNECT ? "Click to pair with the chosen device and connect it." :
            icon == D_DISCONNECT ? "Click to disconnect the chosen device. It is not brought back until you connect it again." :
            icon == D_FORGET ? "Click to remove the chosen device's pairing. It will have to pair again." :
            icon >= D_ROW0 && icon < D_ROW0 + LIST_ROWS ? "Click to choose this device." :
            "This window lists Bluetooth devices: paired ones first, then those found by Scan.";
        snprintf(reply_text, sizeof(reply_text), "%s", text);
    }
    else if (pair_window != 0 && message[8] == pair_window)
        snprintf(reply_text, sizeof(reply_text),
                 "Answer Yes when the number on the device matches; No to refuse pairing.");
    else
        return;
    memset(reply, 0, sizeof(reply));
    strcpy((char *)(reply + 5), reply_text);
    reply[0] = (int)((20 + strlen(reply_text) + 4) & ~3u);
    reply[3] = message[2];
    reply[4] = MESSAGE_HELP_REPLY;
    bt_send_message(WIMP_MESSAGE, reply, message[1]);
}

static void on_click(const int *block)
{
    if (devices_window != 0 && block[3] == devices_window)
    {
        on_devices_click(block);
        return;
    }
    if (pair_window != 0 && block[3] == pair_window)
    {
        pair_click(block);
        return;
    }
    if (block[3] != -2) return;
    if (block[2] == BUTTON_MENU) open_menu(block[0]);
    else if (block[2] == BUTTON_SELECT) open_devices();
    else if (block[2] == BUTTON_ADJUST) open_configure();
}

int main(int argc, char **argv)
{
    int block[64];
    int done = 0, index;
    (void)argc;
    (void)argv;
    if (!bt_wimp_initialise(TASK_NAME)) return 1;
    for (index = 0; index < LIST_ROWS; ++index) row_device[index] = -1;
    bt_settings_load(&settings);
    iconbar_icon = bt_iconbar_create("bt_busy");
    create_info_window();
    create_devices_window();
    create_pair_window();
    /* Start straight away when the drivers are ready (or may be loaded
     * without asking); otherwise wait until the user asks. */
    if (bt_usb_stack_ready() || settings.load_usb_drivers)
        if (!start_core(0))
        {
            /* At boot the adapter may still be enumerating: try again
             * every 3 s for a minute rather than wait for a click. */
            boot_tries = 20;
            boot_retry_at = bt_monotonic() + 300;
        }
    poll_core();
    while (!done)
    {
        int reason = bt_wimp_poll(quitting ? 5 : 25, block);
        switch (reason)
        {
        case WIMP_NULL:
            poll_core();
            if (scan_when_ready && core_state == CORE_READY)
            {
                scan_when_ready = 0;
                start_scan();
            }
            break;
        case WIMP_OPEN: bt_window_reopen(block); break;
        case WIMP_CLOSE:
            if (pair_window != 0 && block[0] == pair_window) pair_reply(0);
            bt_window_close(block[0]);
            break;
        case WIMP_CLICK: on_click(block); break;
        case 8:   /* Key_Pressed: none of ours, so pass it on (hotkeys) */
        {
            _kernel_swi_regs key;
            memset(&key, 0, sizeof(key));
            key.r[0] = block[6];
            (void)_kernel_swi(0x400DC, &key, &key);   /* Wimp_ProcessKey */
            break;
        }
        case WIMP_MENU: on_menu(block); break;
        case WIMP_MESSAGE:
        case WIMP_MESSAGE_RECORDED:
            if (block[4] == MESSAGE_TASK_INITIALISE)
            {
                /* A second copy would fight this one for the core: the
                 * newcomer is asked to go away. */
                const char *name = (const char *)(block + 7);
                if (block[1] != bt_wimp_task() &&
                    strcmp(name, TASK_NAME) == 0)
                {
                    int quit[5];
                    memset(quit, 0, sizeof(quit));
                    quit[0] = 20;
                    quit[4] = MESSAGE_QUIT;
                    bt_send_message(WIMP_MESSAGE, quit, block[1]);
                }
            }
            else if (block[4] == MESSAGE_QUIT && !quitting) begin_quit();
            else if (block[4] == MESSAGE_HELP_REQUEST) on_help(block);
            break;
        default: break;
        }
        if (quitting && (core_state == CORE_OFF ||
                         bt_monotonic() - quit_started > 600))
            done = 1;
    }
    bt_wimp_finalise();
    return 0;
}
