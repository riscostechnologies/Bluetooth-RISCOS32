#define _POSIX_C_SOURCE 200809L
#include "btwimp.h"
#include <swis.h>
#include <stdlib.h>
#include <string.h>

#define TASK_WORD 0x4b534154
#define WINDOW_HEADER 88
#define ICON_BYTES 32
#define MENU_ITEMS_MAX 12

static int task_handle;
static char task_name[40];

static _kernel_oserror *swi(int number, _kernel_swi_regs *regs)
{
    return _kernel_swi(number, regs, regs);
}

unsigned int bt_flags_label(void)
{
    /* text, vcentre, indirected, black; background colour 1 (the window
     * grey) so the Wimp blends the text onto the window, not onto white */
    return 0x1u | 0x10u | 0x100u | (7u << 24) | (1u << 28);
}

unsigned int bt_flags_writable(void)
{
    /* text, border, vcentre, filled, indirected, writable, black on white */
    return 0x1u | 0x4u | 0x10u | 0x20u | 0x100u | (15u << 12) | (7u << 24);
}

unsigned int bt_flags_option(void)
{
    /* text + sprite (optoff/opton), vcentre, indirected, click, unfilled
     * on the window grey like a template option icon */
    return 0x1u | 0x2u | 0x10u | 0x100u | (3u << 12) | (7u << 24) |
           (1u << 28);
}

unsigned int bt_flags_action(void)
{
    /* text, border, centred, filled, indirected, click, black on grey */
    return 0x1u | 0x4u | 0x8u | 0x10u | 0x20u | 0x100u | (3u << 12) |
           (7u << 24) | (1u << 28);
}

int bt_wimp_initialise(const char *name)
{
    _kernel_swi_regs regs;
    memset(&regs, 0, sizeof(regs));
    strncpy(task_name, name, sizeof(task_name) - 1);
    regs.r[0] = 310;
    regs.r[1] = TASK_WORD;
    regs.r[2] = (int)task_name;
    regs.r[3] = 0; /* every message */
    if (swi(Wimp_Initialise, &regs) != NULL) return 0;
    task_handle = regs.r[1];
    return 1;
}

void bt_wimp_finalise(void)
{
    _kernel_swi_regs regs;
    if (task_handle == 0) return;
    memset(&regs, 0, sizeof(regs));
    regs.r[0] = task_handle;
    regs.r[1] = TASK_WORD;
    (void)swi(Wimp_CloseDown, &regs);
    task_handle = 0;
}

int bt_wimp_task(void)
{
    return task_handle;
}

int bt_monotonic(void)
{
    _kernel_swi_regs regs;
    memset(&regs, 0, sizeof(regs));
    if (swi(OS_ReadMonotonicTime, &regs) != NULL) return 0;
    return regs.r[0];
}

int bt_wimp_poll(int idle_cs, int *block)
{
    _kernel_swi_regs regs;
    _kernel_oserror *error;
    memset(&regs, 0, sizeof(regs));
    regs.r[1] = (int)block;
    if (idle_cs > 0)
    {
        regs.r[0] = 0;
        regs.r[2] = bt_monotonic() + idle_cs;
        error = swi(Wimp_PollIdle, &regs);
    }
    else
    {
        regs.r[0] = idle_cs < 0 ? 1 : 0;
        error = swi(Wimp_Poll, &regs);
    }
    if (error != NULL)
    {
        bt_report_os(error);
        return WIMP_NULL;
    }
    return regs.r[0];
}

static void fill_icon(int *icon, const bt_icon_spec *spec)
{
    int size = spec->buffer_size;
    char *buffer;
    if (size <= 0) size = (int)strlen(spec->text) + 1;
    buffer = calloc((size_t)size, 1);
    if (buffer != NULL) strncpy(buffer, spec->text, (size_t)size - 1);
    icon[0] = spec->x0;
    icon[1] = spec->y0;
    icon[2] = spec->x1;
    icon[3] = spec->y1;
    icon[4] = (int)spec->flags;
    icon[5] = (int)buffer;
    icon[6] = spec->validation != NULL ? (int)spec->validation : -1;
    icon[7] = size;
}

int bt_window_create(const char *title, int width, int height,
                     const bt_icon_spec *icons, int count, int with_close)
{
    _kernel_swi_regs regs;
    int *block, index, handle;
    unsigned char *bytes;
    block = calloc(1, (size_t)(WINDOW_HEADER + ICON_BYTES * count));
    if (block == NULL) return 0;
    bytes = (unsigned char *)block;
    block[0] = 0;
    block[1] = 0;
    block[2] = width;
    block[3] = height;
    block[6] = -1;
    /* new format, title bar, back icon, moveable, redrawn by the Wimp */
    block[7] = (int)(0x80000000u | (1u << 26) | (1u << 24) | 0x2u | 0x10u |
                     (with_close ? (1u << 25) : 0u));
    bytes[32] = 7;  /* title foreground */
    bytes[33] = 2;  /* title background */
    bytes[34] = 7;  /* work foreground */
    bytes[35] = 1;  /* work background */
    bytes[36] = 3;
    bytes[37] = 1;
    bytes[38] = 12;
    block[10] = 0;
    block[11] = -height;
    block[12] = width;
    block[13] = 0;
    block[14] = 0x119;       /* title: indirected, centred text */
    block[15] = 10 << 12;    /* work area: click/drag/double */
    block[16] = 1;           /* Wimp sprite pool */
    block[18] = (int)title;
    block[19] = -1;
    block[20] = (int)strlen(title) + 1;
    block[21] = count;
    for (index = 0; index < count; ++index)
        fill_icon(block + 22 + index * 8, icons + index);
    memset(&regs, 0, sizeof(regs));
    regs.r[1] = (int)block;
    handle = swi(Wimp_CreateWindow, &regs) == NULL ? regs.r[0] : 0;
    free(block); /* icon buffers stay: the window refers to them */
    return handle;
}

static void open_window(int window, int x0, int y1, int width, int height)
{
    _kernel_swi_regs regs;
    int block[8];
    block[0] = window;
    block[1] = x0;
    block[2] = y1 - height;
    block[3] = x0 + width;
    block[4] = y1;
    block[5] = 0;
    block[6] = 0;
    block[7] = -1;
    memset(&regs, 0, sizeof(regs));
    regs.r[1] = (int)block;
    (void)swi(Wimp_OpenWindow, &regs);
}

static int extent(int window, int *width, int *height)
{
    _kernel_swi_regs regs;
    int block[23];
    block[0] = window;
    memset(&regs, 0, sizeof(regs));
    regs.r[1] = (int)block | 1; /* header only */
    if (swi(Wimp_GetWindowInfo, &regs) != NULL) return 0;
    *width = block[13] - block[11];
    *height = block[14] - block[12];
    return 1;
}

void bt_window_open_at(int window, int x0, int y1)
{
    int width, height;
    if (!extent(window, &width, &height)) return;
    open_window(window, x0, y1, width, height);
}

void bt_window_open_centred(int window)
{
    _kernel_swi_regs regs;
    int width, height, screen_x, screen_y;
    {
        /* Already open: to the front where it is, not back to the middle. */
        int state[9];
        state[0] = window;
        memset(&regs, 0, sizeof(regs));
        regs.r[1] = (int)state;
        if (swi(Wimp_GetWindowState, &regs) == NULL && (state[8] & (1 << 16)))
        {
            state[7] = -1;
            regs.r[1] = (int)state;
            (void)swi(Wimp_OpenWindow, &regs);
            return;
        }
    }
    if (!extent(window, &width, &height)) return;
    memset(&regs, 0, sizeof(regs));
    regs.r[0] = -1;
    regs.r[1] = 11; /* XWindLimit */
    (void)swi(OS_ReadModeVariable, &regs);
    screen_x = regs.r[2] + 1;
    regs.r[0] = -1;
    regs.r[1] = 4; /* XEigFactor */
    (void)swi(OS_ReadModeVariable, &regs);
    screen_x <<= regs.r[2];
    regs.r[0] = -1;
    regs.r[1] = 12; /* YWindLimit */
    (void)swi(OS_ReadModeVariable, &regs);
    screen_y = regs.r[2] + 1;
    regs.r[0] = -1;
    regs.r[1] = 5; /* YEigFactor */
    (void)swi(OS_ReadModeVariable, &regs);
    screen_y <<= regs.r[2];
    open_window(window, (screen_x - width) / 2, (screen_y + height) / 2,
                width, height);
}

void bt_window_reopen(int *open_block)
{
    _kernel_swi_regs regs;
    memset(&regs, 0, sizeof(regs));
    regs.r[1] = (int)open_block;
    (void)swi(Wimp_OpenWindow, &regs);
}

void bt_window_close(int window)
{
    _kernel_swi_regs regs;
    memset(&regs, 0, sizeof(regs));
    regs.r[1] = (int)&window;
    (void)swi(Wimp_CloseWindow, &regs);
}

static int icon_state(int window, int icon, int block[10])
{
    _kernel_swi_regs regs;
    block[0] = window;
    block[1] = icon;
    memset(&regs, 0, sizeof(regs));
    regs.r[1] = (int)block;
    return swi(Wimp_GetIconState, &regs) == NULL;
}

char *bt_icon_text(int window, int icon)
{
    int block[10];
    static char empty[1];
    if (!icon_state(window, icon, block)) return empty;
    return (char *)block[7];
}

void bt_icon_redraw(int window, int icon)
{
    _kernel_swi_regs regs;
    int block[4];
    block[0] = window;
    block[1] = icon;
    block[2] = 0;
    block[3] = 0;
    memset(&regs, 0, sizeof(regs));
    regs.r[1] = (int)block;
    (void)swi(Wimp_SetIconState, &regs);
}

void bt_icon_set_text(int window, int icon, const char *text)
{
    int block[10];
    if (!icon_state(window, icon, block)) return;
    strncpy((char *)block[7], text, (size_t)block[9] - 1);
    ((char *)block[7])[block[9] - 1] = '\0';
    bt_icon_redraw(window, icon);
}

int bt_icon_selected(int window, int icon)
{
    int block[10];
    return icon_state(window, icon, block) &&
           ((unsigned int)block[6] & ICON_SELECTED) != 0;
}

static void set_flag(int window, int icon, unsigned int flag, int on)
{
    _kernel_swi_regs regs;
    int block[4];
    block[0] = window;
    block[1] = icon;
    block[2] = on ? (int)flag : 0;
    block[3] = (int)flag;
    memset(&regs, 0, sizeof(regs));
    regs.r[1] = (int)block;
    (void)swi(Wimp_SetIconState, &regs);
}

void bt_icon_set_selected(int window, int icon, int selected)
{
    set_flag(window, icon, ICON_SELECTED, selected);
}

void bt_icon_set_shaded(int window, int icon, int shaded)
{
    set_flag(window, icon, ICON_SHADED, shaded);
}

void bt_caret_to(int window, int icon)
{
    _kernel_swi_regs regs;
    memset(&regs, 0, sizeof(regs));
    regs.r[0] = window;
    regs.r[1] = icon;
    regs.r[4] = -1;
    regs.r[5] = (int)strlen(bt_icon_text(window, icon));
    (void)swi(Wimp_SetCaretPosition, &regs);
}

static char iconbar_sprite[13];

int bt_iconbar_create(const char *sprite)
{
    _kernel_swi_regs regs;
    int block[9];
    strncpy(iconbar_sprite, sprite, sizeof(iconbar_sprite) - 1);
    block[0] = -1; /* right-hand side */
    block[1] = 0;
    block[2] = 0;
    block[3] = 68;
    block[4] = 68;
    block[5] = 0x2 | 0x100 | (3 << 12); /* sprite, indirected, click */
    block[6] = (int)iconbar_sprite;
    block[7] = 1;
    block[8] = sizeof(iconbar_sprite);
    memset(&regs, 0, sizeof(regs));
    regs.r[1] = (int)block;
    if (swi(Wimp_CreateIcon, &regs) != NULL) return -1;
    return regs.r[0];
}

void bt_iconbar_set_sprite(int icon, const char *sprite)
{
    if (strcmp(iconbar_sprite, sprite) == 0) return;
    memset(iconbar_sprite, 0, sizeof(iconbar_sprite));
    strncpy(iconbar_sprite, sprite, sizeof(iconbar_sprite) - 1);
    bt_icon_redraw(-2, icon);
}

static int menu_block[7 + MENU_ITEMS_MAX * 6];

int *bt_menu_build(const char *title, const bt_menu_item *items, int count)
{
    unsigned char *bytes = (unsigned char *)menu_block;
    size_t widest = strlen(title);
    int index;
    if (count > MENU_ITEMS_MAX) count = MENU_ITEMS_MAX;
    memset(menu_block, 0, sizeof(menu_block));
    strncpy((char *)menu_block, title, 12);
    bytes[12] = 7;
    bytes[13] = 2;
    bytes[14] = 7;
    bytes[15] = 0;
    for (index = 0; index < count; ++index)
    {
        int *item = menu_block + 7 + index * 6;
        unsigned int flags = 0;
        if (strlen(items[index].text) > widest)
            widest = strlen(items[index].text);
        if (items[index].ticked) flags |= 1u;
        if (items[index].dotted) flags |= 2u;
        if (index == count - 1) flags |= 0x80u;
        item[0] = (int)flags;
        item[1] = items[index].submenu != 0 ? items[index].submenu : -1;
        item[2] = (int)(0x1u | 0x10u | 0x20u | 0x100u | (7u << 24) |
                        (items[index].shaded ? ICON_SHADED : 0u));
        item[3] = (int)items[index].text;
        item[4] = -1;
        item[5] = (int)strlen(items[index].text) + 1;
    }
    menu_block[4] = (int)(widest * 16 + 16);
    menu_block[5] = 44;
    menu_block[6] = 0;
    return menu_block;
}

void bt_menu_open(int *menu, int x, int y)
{
    _kernel_swi_regs regs;
    memset(&regs, 0, sizeof(regs));
    regs.r[1] = (int)menu;
    regs.r[2] = x;
    regs.r[3] = y;
    (void)swi(Wimp_CreateMenu, &regs);
}

void bt_report(const char *text, int is_error)
{
    _kernel_oserror error;
    error.errnum = 0;
    strncpy(error.errmess, text, sizeof(error.errmess) - 1);
    error.errmess[sizeof(error.errmess) - 1] = '\0';
    {
        _kernel_swi_regs regs;
        memset(&regs, 0, sizeof(regs));
        regs.r[0] = (int)&error;
        regs.r[1] = 1 | (1 << 8) | ((is_error ? 2 : 1) << 9);
        regs.r[2] = (int)task_name;
        regs.r[3] = (int)"!bluetooth";
        regs.r[4] = 1;
        (void)swi(Wimp_ReportError, &regs);
    }
}

int bt_ask(const char *text, const char *buttons)
{
    _kernel_oserror error;
    _kernel_swi_regs regs;
    error.errnum = 0;
    strncpy(error.errmess, text, sizeof(error.errmess) - 1);
    error.errmess[sizeof(error.errmess) - 1] = '\0';
    memset(&regs, 0, sizeof(regs));
    regs.r[0] = (int)&error;
    regs.r[1] = (1 << 8) | (4 << 9); /* new style, question */
    regs.r[2] = (int)task_name;
    regs.r[3] = (int)"!bluetooth";
    regs.r[4] = 1;
    regs.r[5] = (int)buttons;
    if (swi(Wimp_ReportError, &regs) != NULL) return -1;
    return regs.r[1] - 3;
}

void bt_report_os(const _kernel_oserror *error)
{
    if (error != NULL) bt_report(error->errmess, 1);
}

void bt_send_message(int reason, int *message, int destination)
{
    _kernel_swi_regs regs;
    memset(&regs, 0, sizeof(regs));
    regs.r[0] = reason;
    regs.r[1] = (int)message;
    regs.r[2] = destination;
    (void)swi(Wimp_SendMessage, &regs);
}

void bt_start_task(const char *command)
{
    _kernel_swi_regs regs;
    _kernel_oserror *error;
    memset(&regs, 0, sizeof(regs));
    regs.r[0] = (int)command;
    error = swi(Wimp_StartTask, &regs);
    if (error != NULL) bt_report_os(error);
}
