/* Credit accounting adapted from NetBSD rfcomm_dlc_start and recv_uih.
 * Fixed packet slots replace its byte-oriented mbuf receive-space tracking. */
#include "rfcomm_credit.h"
#include <string.h>

int btv_rfcomm_credit_init(btv_rfcomm_credit *credit, uint16_t mtu,
                           uint16_t slots, uint8_t initial_receive, uint8_t initial_transmit)
{
    if (credit == NULL || mtu < 23 || mtu > 32767 || slots == 0 ||
        initial_receive > 7 || initial_transmit > 7 || initial_receive > slots)
        return 0;
    memset(credit, 0, sizeof(*credit));
    credit->active = 1;
    credit->mtu = mtu;
    credit->slots = slots;
    credit->receive_outstanding = initial_receive;
    credit->transmit_available = initial_transmit;
    return 1;
}

void btv_rfcomm_credit_abort(btv_rfcomm_credit *credit)
{
    if (credit != NULL)
        credit->failed = 1;
}

unsigned int btv_rfcomm_credit_grant(const btv_rfcomm_credit *credit)
{
    unsigned int available;
    if (credit == NULL || !credit->active || credit->failed)
        return 0;
    available = credit->slots - credit->occupied - credit->receive_outstanding;
    return available > 255 ? 255 : available;
}

int btv_rfcomm_credit_can_send(const btv_rfcomm_credit *credit, size_t bytes, unsigned int grant)
{
    if (credit == NULL || !credit->active || credit->failed)
        return -1;
    if (bytes > credit->mtu || grant > btv_rfcomm_credit_grant(credit) ||
        (bytes != 0 && credit->transmit_available == 0))
        return 0;
    return 1;
}

int btv_rfcomm_credit_sent(btv_rfcomm_credit *credit, size_t bytes, unsigned int grant)
{
    if (btv_rfcomm_credit_can_send(credit, bytes, grant) != 1)
    {
        btv_rfcomm_credit_abort(credit);
        return -1;
    }
    if (bytes != 0)
        --credit->transmit_available;
    credit->receive_outstanding = (uint16_t)(credit->receive_outstanding + grant);
    return 1;
}

int btv_rfcomm_credit_received(btv_rfcomm_credit *credit, size_t bytes, unsigned int grant)
{
    if (credit == NULL || !credit->active || credit->failed)
        return -1;
    if (grant > 255 || grant > 65535U - credit->transmit_available || bytes > credit->mtu ||
        (bytes != 0 && (credit->receive_outstanding == 0 || credit->occupied >= credit->slots)))
    {
        btv_rfcomm_credit_abort(credit);
        return -1;
    }
    credit->transmit_available = (uint16_t)(credit->transmit_available + grant);
    if (bytes != 0)
    {
        --credit->receive_outstanding;
        ++credit->occupied;
    }
    return 1;
}

int btv_rfcomm_credit_release(btv_rfcomm_credit *credit, unsigned int packets)
{
    if (credit == NULL || !credit->active || credit->failed)
        return -1;
    if (packets > credit->occupied)
    {
        btv_rfcomm_credit_abort(credit);
        return -1;
    }
    credit->occupied = (uint16_t)(credit->occupied - packets);
    return 1;
}
