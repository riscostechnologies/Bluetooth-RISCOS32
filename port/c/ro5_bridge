/* ---- SWIs (called through _kernel_swi, which adds the X bit) ---------- */
#define SWI_OS_Module              0x1E
#define SWI_OS_ReadVarVal          0x23
#define SWI_OS_SWINumberFromString 0x39
#define SWI_OS_ReadMonotonicTime   0x42
#define SWI_OS_Memory              0x68

/* ---- hardware ---------------------------------------------------------- */
#define PERI_PHYS     0xFE000000u
#define GPIO_PHYS     (PERI_PHYS + 0x200000u)
#define UART_PHYS     (PERI_PHYS + 0x201000u)
#define MBOX_PAGE     (PERI_PHYS + 0x00B000u)
#define MBOX_OFFSET   0x880u
#define PAGE          0x1000u
#define VC_BUS_ALIAS  0xC0000000u      /* uncached bus alias of ARM memory */

#define GPFSEL1       0x04u            /* pins 10-19 */
#define GPFSEL3       0x0Cu            /* pins 30-39 */
#define GPCLR0        0x28u            /* pins 0-31: drive low */
#define FSEL_IN       0u
#define FSEL_OUT      1u
#define FSEL_ALT0     4u
#define FSEL_ALT3     7u

#define U_DR          0x00u
#define U_FR          0x18u
#define U_IBRD        0x24u
#define U_FBRD        0x28u
#define U_LCRH        0x2Cu
#define U_CR          0x30u
#define U_IMSC        0x38u
#define U_ICR         0x44u
#define FR_RXFE       (1u << 4)
#define FR_TXFF       (1u << 5)
#define FR_BUSY       (1u << 3)
#define IM_TX         (1u << 5)        /* U_IMSC transmit interrupt */
#define DR_ERRORS     0xF00u           /* framing, parity, break, overrun */
#define DR_OE         (1u << 11)
#define LCRH_FEN      (1u << 4)
#define LCRH_8BIT     (3u << 5)
#define CR_UARTEN     (1u << 0)
#define CR_TXE        (1u << 8)
#define CR_RXE        (1u << 9)
#define CR_RTSEN      (1u << 14)
#define CR_CTSEN      (1u << 15)
#define UART_CLOCK    48000000u
#define LINK_BAUD     115200u

#define MB_READ       0x00u
#define MB_STATUS     0x18u
#define MB_WRITE      0x20u
#define MB_FULL       0x80000000u
#define MB_EMPTY      0x40000000u
#define MB_CHANNEL    8u
#define MB_SPIN       2000000u

#define TAG_BOARD_REVISION  0x00010002u
#define TAG_SET_GPIO_STATE  0x00038041u
#define TAG_SET_GPIO_CONFIG 0x00038043u
#define TAG_GET_GPIO_STATE  0x00030041u
#define TAG_FIRMWARE_REV    0x00000001u
#define BT_ON_GPIO          128u

/* ---- queues ------------------------------------------------------------ */
#define EVENTS        64u
#define EVENT_BYTES   260u
#define ACLS          16u
#define TX_SLOTS      16u
#define STAGE_BYTES   4096u            /* a power of two */
#define KIND_SHIFT    24
#define SEQ_MASK      0xFFFFFFu
#define TX_RING       8192u            /* a power of two (edition 15) */

#define OP_RESET          0x0C03u
#define OP_READ_VERSION   0x1001u
#define OP_READ_BDADDR    0x1009u
#define REPLY_MS          1000u
#define PATCH_NAME        "BCM4345C0"  /* the Pi 4 / Pi 400 / CM4 radio */

enum boot_state
{
    RB_IDLE, RB_POWER_OFF, RB_POWER_ON, RB_RESET_WAIT, RB_MINI_WAIT,
    RB_MINI_PAUSE, RB_RECORD_WAIT, RB_LAUNCH_PAUSE, RB_RESET2_WAIT,
    RB_VERSION_WAIT, RB_ADDRESS_WAIT, RB_BAUD_WAIT, RB_BAUD_SETTLE, RB_BAUD_CHECK,
    RB_DONE, RB_FAILED
