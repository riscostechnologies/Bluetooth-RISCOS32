/* Multiply by x in GF(2^8). */
#define XTIME(b) ((uint8_t) (((b) << 1) ^ (((b) & 0x80) ? 0x1b : 0)))

/* Byte-oriented AES-128. The round key is expanded in place, one round at
 * a time, so only two 16-octet work areas are needed. */
void btv_aes128_encrypt(const uint8_t key[16], const uint8_t in[16],
                        uint8_t out[16])
{
    uint8_t s[16], rk[16], t[4];
    uint8_t rcon = 0x01;
    unsigned int round, i, c;

    memcpy(rk, key, 16);
    for (i = 0; i < 16; i++)
        s[i] = (uint8_t) (in[i] ^ rk[i]);

    for (round = 1; round <= 10; round++)
    {
        /* SubBytes and ShiftRows together; column-major state. */
        t[0] = s[1];
        s[1] = btv_aes_sbox[s[5]];
        s[5] = btv_aes_sbox[s[9]];
        s[9] = btv_aes_sbox[s[13]];
        s[13] = btv_aes_sbox[t[0]];
        t[0] = s[2];
        t[1] = s[6];
        s[2] = btv_aes_sbox[s[10]];
        s[6] = btv_aes_sbox[s[14]];
        s[10] = btv_aes_sbox[t[0]];
        s[14] = btv_aes_sbox[t[1]];
        t[0] = s[15];
        s[15] = btv_aes_sbox[s[11]];
        s[11] = btv_aes_sbox[s[7]];
        s[7] = btv_aes_sbox[s[3]];
        s[3] = btv_aes_sbox[t[0]];
        s[0] = btv_aes_sbox[s[0]];
        s[4] = btv_aes_sbox[s[4]];
        s[8] = btv_aes_sbox[s[8]];
        s[12] = btv_aes_sbox[s[12]];

        if (round != 10)
        {
            /* MixColumns. */
            for (c = 0; c < 16; c += 4)
            {
                uint8_t a0 = s[c], a1 = s[c + 1], a2 = s[c + 2], a3 = s[c + 3];
                uint8_t all = (uint8_t) (a0 ^ a1 ^ a2 ^ a3);
                s[c] = (uint8_t) (a0 ^ all ^ XTIME((uint8_t) (a0 ^ a1)));
                s[c + 1] = (uint8_t) (a1 ^ all ^ XTIME((uint8_t) (a1 ^ a2)));
                s[c + 2] = (uint8_t) (a2 ^ all ^ XTIME((uint8_t) (a2 ^ a3)));
                s[c + 3] = (uint8_t) (a3 ^ all ^ XTIME((uint8_t) (a3 ^ a0)));
            }
        }

        /* Next round key. */
        rk[0] ^= (uint8_t) (btv_aes_sbox[rk[13]] ^ rcon);
        rk[1] ^= btv_aes_sbox[rk[14]];
        rk[2] ^= btv_aes_sbox[rk[15]];
        rk[3] ^= btv_aes_sbox[rk[12]];
        for (i = 4; i < 16; i++)
            rk[i] ^= rk[i - 4];
        rcon = XTIME(rcon);

        for (i = 0; i < 16; i++)
            s[i] ^= rk[i];
    }
    memcpy(out, s, 16);
}

/* RFC 4493 subkey step: left shift by one, conditional Rb. */
static void btv_cmac_double(uint8_t block[16])
{
    unsigned int i;
    uint8_t carry = (uint8_t) ((block[0] & 0x80) ? 0x87 : 0);
    for (i = 0; i < 15; i++)
        block[i] = (uint8_t) ((block[i] << 1) | (block[i + 1] >> 7));
    block[15] = (uint8_t) ((block[15] << 1) ^ carry);
}

void btv_aes_cmac(const uint8_t key[16], const uint8_t *message,
                  unsigned int length, uint8_t out[16])
{
    uint8_t x[16], sub[16];
    unsigned int i;

    memset(sub, 0, 16);
    btv_aes128_encrypt(key, sub, sub);
    btv_cmac_double(sub);                       /* K1 */

    memset(x, 0, 16);
    /* All blocks except the last (a zero-length message has one block). */
    while (length > 16)
    {
        for (i = 0; i < 16; i++)
            x[i] ^= message[i];
        btv_aes128_encrypt(key, x, x);
        message += 16;
        length -= 16;
    }
    if (length == 16)
    {
        for (i = 0; i < 16; i++)
            x[i] ^= (uint8_t) (message[i] ^ sub[i]);
    }
    else
    {
        btv_cmac_double(sub);                   /* K2, with 10* padding */
        for (i = 0; i < length; i++)
            x[i] ^= (uint8_t) (message[i] ^ sub[i]);
        x[length] ^= (uint8_t) (0x80 ^ sub[length]);
        for (i = length + 1; i < 16; i++)
            x[i] ^= sub[i];
    }
    btv_aes128_encrypt(key, x, out);
}

/* Copy src reversed into dst (dst and src must not overlap). */
static void btv_reverse(uint8_t *dst, const uint8_t *src, unsigned int n)
{
    unsigned int i;
    for (i = 0; i < n; i++)
        dst[i] = src[n - 1 - i];
}

/* Spec function e(): AES on LSB-first key/plaintext, LSB-first result.
 * in and out may alias. */
static void btv_e_lsb(const uint8_t k[16], const uint8_t in[16],
                      uint8_t out[16])
{
    uint8_t key[16], block[16];
    btv_reverse(key, k, 16);
    btv_reverse(block, in, 16);
    btv_aes128_encrypt(key, block, block);
    btv_reverse(out, block, 16);
}

/* AES-CMAC with LSB-first key over an MSB-first message, LSB-first tag. */
static void btv_cmac_lsb(const uint8_t k[16], const uint8_t *message,
                         unsigned int length, uint8_t out[16])
{
    uint8_t key[16], tag[16];
    btv_reverse(key, k, 16);
    btv_aes_cmac(key, message, length, tag);
    btv_reverse(out, tag, 16);
}

/* Append an MSB-first 56-bit address (type || address) at dst. */
static void btv_put_addr(uint8_t *dst, uint8_t type, const uint8_t addr[6])
{
    dst[0] = type;
    btv_reverse(dst + 1, addr, 6);
}

void btv_smp_c1(const uint8_t k[16], const uint8_t r[16],
                const uint8_t preq[7], const uint8_t pres[7],
                uint8_t iat, const uint8_t ia[6],
                uint8_t rat, const uint8_t ra[6], uint8_t out[16])
{
    uint8_t p[16];
    unsigned int i;

    /* p1 = pres || preq || rat' || iat' (MSB-first); LSB-first that is
     * iat', rat', preq[0..6], pres[0..6]. */
    p[0] = (uint8_t) (iat & 1);
    p[1] = (uint8_t) (rat & 1);
    memcpy(p + 2, preq, 7);
    memcpy(p + 9, pres, 7);
    for (i = 0; i < 16; i++)
        p[i] ^= r[i];
    btv_e_lsb(k, p, p);

    /* p2 = padding(32) || ia || ra (MSB-first); LSB-first that is
     * ra[0..5], ia[0..5], 0 0 0 0. */
    for (i = 0; i < 6; i++)
    {
        p[i] ^= ra[i];
        p[i + 6] ^= ia[i];
    }
    btv_e_lsb(k, p, out);
}

void btv_smp_s1(const uint8_t k[16], const uint8_t r1[16],
                const uint8_t r2[16], uint8_t out[16])
{
    uint8_t r[16];
    /* r' = r1' || r2' (least significant 64 bits of each, MSB-first);
     * LSB-first that is r2[0..7], r1[0..7]. */
    memcpy(r, r2, 8);
    memcpy(r + 8, r1, 8);
    btv_e_lsb(k, r, out);
}

void btv_smp_ah(const uint8_t irk[16], const uint8_t r[3], uint8_t out[3])
{
    uint8_t block[16];
    /* r' = padding(104) || r; result is the least significant 24 bits. */
    memset(block, 0, 16);
    memcpy(block, r, 3);
    btv_e_lsb(irk, block, block);
    memcpy(out, block, 3);
}

void btv_smp_f4(const uint8_t u[32], const uint8_t v[32],
                const uint8_t x[16], uint8_t z, uint8_t out[16])
{
    uint8_t m[65];
    /* M = U || V || Z, MSB-first. */
    btv_reverse(m, u, 32);
    btv_reverse(m + 32, v, 32);
    m[64] = z;
    btv_cmac_lsb(x, m, 65, out);
}

void btv_smp_f5(const uint8_t w[32], const uint8_t n1[16],
                const uint8_t n2[16], uint8_t a1t, const uint8_t a1[6],
                uint8_t a2t, const uint8_t a2[6],
                uint8_t mackey[16], uint8_t ltk[16])
{
    static const uint8_t salt[16] =
    {
        0x6c, 0x88, 0x83, 0x91, 0xaa, 0xf5, 0xa5, 0x38,
        0x60, 0x37, 0x0b, 0xdb, 0x5a, 0x60, 0x83, 0xbe
    };
    uint8_t t[16], m[53];

    /* T = AES-CMAC_SALT(W); SALT and the reversed W are MSB-first. */
    btv_reverse(m, w, 32);
    btv_aes_cmac(salt, m, 32, t);

    /* M = Counter || keyID "btle" || N1 || N2 || A1 || A2 || Length 256. */
    m[0] = 0;
    m[1] = 0x62;
    m[2] = 0x74;
    m[3] = 0x6c;
    m[4] = 0x65;
    btv_reverse(m + 5, n1, 16);
    btv_reverse(m + 21, n2, 16);
    btv_put_addr(m + 37, a1t, a1);
    btv_put_addr(m + 44, a2t, a2);
    m[51] = 0x01;
    m[52] = 0x00;

    btv_aes_cmac(t, m, 53, m);      /* tag overwrites m[0..15] only */
    btv_reverse(mackey, m, 16);

    /* Rebuild the prefix clobbered by the first tag, counter = 1. */
    m[0] = 1;
    m[1] = 0x62;
    m[2] = 0x74;
    m[3] = 0x6c;
    m[4] = 0x65;
    btv_reverse(m + 5, n1 + 5, 11); /* first 11 octets of reversed N1 */
    btv_aes_cmac(t, m, 53, m);
    btv_reverse(ltk, m, 16);
}

void btv_smp_f6(const uint8_t w[16], const uint8_t n1[16],
                const uint8_t n2[16], const uint8_t r[16],
                const uint8_t iocap[3], uint8_t a1t, const uint8_t a1[6],
                uint8_t a2t, const uint8_t a2[6], uint8_t out[16])
{
    uint8_t m[65];
    /* M = N1 || N2 || R || IOcap || A1 || A2, MSB-first. */
    btv_reverse(m, n1, 16);
    btv_reverse(m + 16, n2, 16);
    btv_reverse(m + 32, r, 16);
    btv_reverse(m + 48, iocap, 3);
    btv_put_addr(m + 51, a1t, a1);
    btv_put_addr(m + 58, a2t, a2);
    btv_cmac_lsb(w, m, 65, out);
}

uint32_t btv_smp_g2(const uint8_t u[32], const uint8_t v[32],
                    const uint8_t x[16], const uint8_t y[16])
{
    uint8_t m[80], tag[16];
    /* M = U || V || Y, MSB-first; result = least significant 32 bits. */
    btv_reverse(m, u, 32);
    btv_reverse(m + 32, v, 32);
    btv_reverse(m + 64, y, 16);
    btv_cmac_lsb(x, m, 80, tag);
    return (uint32_t) tag[0] | ((uint32_t) tag[1] << 8) |
           ((uint32_t) tag[2] << 16) | ((uint32_t) tag[3] << 24);
}

/* Shift-and-subtract remainder: 1000000 << 12 still fits in 32 bits. */
uint32_t btv_smp_g2_digits(uint32_t value)
{
    uint32_t divisor = (uint32_t) 1000000UL << 12;
    int shift;
    for (shift = 12; shift >= 0; shift--)
    {
        if (value >= divisor)
            value -= divisor;
        divisor >>= 1;
    }
    return value;
}

void btv_smp_h6(const uint8_t w[16], const uint8_t key_id[4],
                uint8_t out[16])
{
    uint8_t m[4];
    btv_reverse(m, key_id, 4);
    btv_cmac_lsb(w, m, 4, out);
}
