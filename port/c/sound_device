/*******************************************************************
 * File:        sound_device
 * Purpose:     A software HAL audio controller (API 2, custom DMA) that
 *              hands SoundDMA's 16-bit stereo buffers to the HFP playback
 *              queue as 8 kHz mono.
 *
 * SoundDMA calls the device entries with R0 = device from arbitrary
 * contexts where this module's C environment is not set up, so every
 * entry is a leaf in the assembler below that only touches the device
 * block.  The C half runs from BluetoothVoice SWIs, which the client
 * issues continuously while a session is ready: whenever the voice link
 * has drained the queue below the low-water mark, it takes the buffer
 * SoundDMA filled last and asks for the next.  SoundDMA fills buffer 0,
 * then 1, alternately, one per callback, so consuming in the same order
 * always reads a buffer filled a whole round earlier.
 ******************************************************************/
#include <sound_device>
#include <sound_pace>
#include "sound_ring.h"
#include <stddef.h>
#include <string.h>

#define OS_HARDWARE_ADD_DEVICE 2u
#define OS_HARDWARE_REMOVE_DEVICE 3u
#define HAL_DEVICE_TYPE_AUDIO_CONTROLLER 0x0201u /* Audio, AudC */
#define HAL_DEVICE_TYPE_AUDIO_MIXER 0x0202u
#define HAL_DEVICE_ID_SOFTWARE_MIXER 1u
/* Beyond the IDs allocated in hdr:HALDevice, so it cannot collide. */
#define HAL_DEVICE_ID_BLUETOOTH_HFP 0x0b70u
#define HAL_DEVICE_LOCATION 0x10000000u /* system bus */
#define HAL_API_2 0x00020000u
#define AUDIO_FLAG_STEREO_REVERSE 1u
#define CONTROLLER_ID_BYTES 40u
/* 16-bit mono at 8 kHz: 1600 bytes is 100 ms, enough to ride out a
 * TaskWindow time slice without the client polling. */
#define LOW_WATER_BYTES 1600u
#define MAX_BUFFERS_PER_PUMP 8u
#define MONO_BYTES 4096u

typedef void btv_hal_entry(void);

typedef struct btv_rate_entry
{
    uint32_t frequency; /* Hz * 1024 */
    uint8_t period;     /* microseconds */
    uint8_t reserved[3];
} btv_rate_entry;

typedef struct btv_audio_device
{
    uint16_t type, id;
    uint32_t location, version;
    const char *description;
    void *address;
    uint32_t reserved1[3];
    btv_hal_entry *activate, *deactivate, *reset, *sleep;
    int32_t device;
    btv_hal_entry *test_irq, *clear_irq;
    uint32_t reserved2;
    void *mixer;
    uint32_t channels_out, channels_in;
    uint32_t dma_params[5];
    btv_hal_entry *pre_enable, *post_enable, *pre_disable, *post_disable;
    btv_hal_entry *irq_handle;
    uint32_t rate_count;
    const btv_rate_entry *rate_table;
    btv_hal_entry *set_rate, *custom_dma_enable;
    uint32_t flags, min_buffer_bytes, buffer_align;
    /* Private: written only by the assembler entries below. */
    uint32_t buffer_bytes;        /* 144 */
    int16_t *buffer[2];           /* 148, 152 */
    uint32_t callback_parameter;  /* 156 */
    void *callback;               /* 160 */
    uint32_t running;             /* 164 */
} btv_audio_device;

/* HAL mixer API 0.1. SoundCtrl discovers this device through OS_Hardware,
 * while SoundDMA obtains the same pointer from the audio controller. */
typedef struct btv_mixer_device
{
    uint16_t type, id;
    uint32_t location, version;
    const char *description;
    void *address;
    uint32_t reserved1[3];
    btv_hal_entry *activate, *deactivate, *reset, *sleep;
    int32_t device;
    btv_hal_entry *test_irq, *clear_irq;
    uint32_t reserved2;
    btv_audio_device *controller;
    uint32_t channels;
    btv_hal_entry *get_features, *set_mix, *get_mix, *get_limits;
    uint32_t mute;
    int32_t gain; /* dB * 16, from -640 to 0 */
} btv_mixer_device;

typedef char btv_check_mixer[
    offsetof(btv_mixer_device, controller) == 64 &&
    offsetof(btv_mixer_device, mute) == 88 &&
    offsetof(btv_mixer_device, gain) == 92 ? 1 : -1];

/* The assembler entries use these offsets literally. */
typedef char btv_check_custom_dma[
    offsetof(btv_audio_device, custom_dma_enable) == 128 ? 1 : -1];
typedef char btv_check_private[
    offsetof(btv_audio_device, buffer_bytes) == 144 &&
    offsetof(btv_audio_device, running) == 164 ? 1 : -1];

extern btv_hal_entry btv_audc_activate, btv_audc_nothing, btv_audc_zero,
    btv_audc_pre_disable, btv_audc_custom_dma_enable;
extern btv_hal_entry btv_mix_features, btv_mix_set, btv_mix_get,
    btv_mix_limits;

/* Activate: R0 = 1 (usable).  Sleep, IRQHandle: R0 = 0.
 * PreDisable: stop consuming before SoundDMA frees the buffers.
 * CustomDMAEnable: R1 = buffer size, R2/R3 = buffers, [SP] = callback
 * parameter, [SP, #4] = callback; R0 = 0 for success. */
__asm__(
    "\t.text\n"
    "\t.arm\n"
    "\t.global btv_audc_activate\n"
    "btv_audc_activate:\n"
    "\tmov r0, #1\n"
    "\tmov pc, lr\n"
    "\t.global btv_audc_zero\n"
    "btv_audc_zero:\n"
    "\tmov r0, #0\n"
    "\t.global btv_audc_nothing\n"
    "btv_audc_nothing:\n"
    "\tmov pc, lr\n"
    "\t.global btv_audc_pre_disable\n"
    "btv_audc_pre_disable:\n"
    "\tmov r1, #0\n"
    "\tstr r1, [r0, #164]\n"
    "\tmov pc, lr\n"
    "\t.global btv_audc_custom_dma_enable\n"
    "btv_audc_custom_dma_enable:\n"
    "\tstr r1, [r0, #144]\n"
    "\tstr r2, [r0, #148]\n"
    "\tstr r3, [r0, #152]\n"
    "\tldr r1, [sp, #0]\n"
    "\tstr r1, [r0, #156]\n"
    "\tldr r1, [sp, #4]\n"
    "\tstr r1, [r0, #160]\n"
    "\tmov r1, #1\n"
    "\tstr r1, [r0, #164]\n"
    "\tmov r0, #0\n"
    "\tmov pc, lr\n");

/* HAL entries run without our module's C static base (R8), so they touch
 * only the RMA mixer block passed in R0. GetMix returns mute/gain in R0/R1. */
__asm__(
    "\t.text\n"
    "\t.arm\n"
    "\t.global btv_mix_features\n"
    "btv_mix_features:\n"
    "\tmov r0, #0\n"             /* System output channel */
    "\tmov pc, lr\n"
    "\t.global btv_mix_set\n"
    "btv_mix_set:\n"
    "\tcmp r3, #0\n"
    "\tmovgt r3, #0\n"
    "\tldr r12, =-640\n"
    "\tcmp r3, r12\n"
    "\tmovlt r3, r12\n"
    "\tand r2, r2, #1\n"
    "\tstr r2, [r0, #88]\n"
    "\tstr r3, [r0, #92]\n"
    "\tmov pc, lr\n"
    "\t.global btv_mix_get\n"
    "btv_mix_get:\n"
    "\tldr r1, [r0, #92]\n"
    "\tldr r0, [r0, #88]\n"
    "\tmov pc, lr\n"
    "\t.global btv_mix_limits\n"
    "btv_mix_limits:\n"
    "\tldr r12, =-640\n"
    "\tstr r12, [r2, #0]\n"
    "\tmov r12, #0\n"
    "\tstr r12, [r2, #4]\n"
    "\tmov r12, #1\n"
    "\tstr r12, [r2, #8]\n"
    "\tmov pc, lr\n"
    "\t.ltorg\n");

static btv_rate_entry rates[1] = { { 8000u * 1024u, 125, { 0, 0, 0 } } };
static const char hfp_description[] = "Bluetooth headset (HFP, 8 kHz)";
static const char a2dp_description[] = "Bluetooth speakers (A2DP)";
static const char mixer_description[] = "Bluetooth software mixer";
static const char *description = hfp_description;
static int stereo_mode;
/* A2DP: SoundDMA's stereo frames wait here for the media clock. */
#define RING_FRAMES 8192u
#define STEREO_LOW_WATER 3072u
/* Buffers allowed before the clock has run: enough to start smoothly. */
#define STEREO_PRIME_BUFFERS 2u
static int16_t ring[RING_FRAMES * 2u];
static uint32_t stereo_rate, stereo_clock;
/* When this device may take another buffer from SoundDMA. */
static btv_sound_pace stereo_pace;
/* SoundDMA fills its buffers from inside the callback we make, so the
 * callback must never be re-entered. */
static int in_sound_dma;
/* Set when a previous instance left a device behind: only a reboot clears
 * it, and registering again would make things worse. */
static int stale_entry;
static unsigned int ring_head, ring_used;
/* The kernel keeps our audio device in its own hardware device list, and
 * walks that list whenever anything enumerates devices.  A node pointing
 * into a dead module's workspace aborts inside the kernel and takes the
 * machine with it, so the block lives in the RMA and is never freed: a
 * few hundred bytes are a cheap insurance against a locked machine. */
static btv_audio_device *device_block;
static btv_mixer_device *mixer_block;
static int mixer_registered;

/* After the device block: a tiny "not usable" entry and a name, so an
 * orphaned device answers safely even with the module gone.  Everything
 * it points at has to live in the block for the same reason. */
#define DEVICE_CODE_OFFSET ((uint32_t)sizeof(btv_audio_device))
#define DEVICE_NAME_OFFSET (DEVICE_CODE_OFFSET + 8u)
#define MIXER_BLOCK_OFFSET (DEVICE_NAME_OFFSET + 24u)
#define DEVICE_BLOCK_BYTES (MIXER_BLOCK_OFFSET + (uint32_t)sizeof(btv_mixer_device))

/* OS_Module 6 (claim).  Returns 0 when the RMA has no room. */
static int claim_device_block(void)
{
    register uint32_t r0 __asm("r0") = 6;
    register uint32_t r1 __asm("r1") = 0;
    register uint32_t r2 __asm("r2") = 0;
    register uint32_t r3 __asm("r3") = (uint32_t)DEVICE_BLOCK_BYTES;
    register uint32_t success __asm("r4");
    if (device_block != NULL) return 1;
    __asm volatile(
        "swi 0x2001e\n\t"
        "movvc %4, #1\n\t"
        "movvs %4, #0"
        : "+r" (r0), "+r" (r1), "+r" (r2), "+r" (r3), "=r" (success)
        :
        : "cc", "memory", "lr");
    if (!success || r2 == 0) return 0;
    device_block = (btv_audio_device *)r2;
    memset(device_block, 0, DEVICE_BLOCK_BYTES);
    mixer_block = (btv_mixer_device *)((uint8_t *)device_block +
                                       MIXER_BLOCK_OFFSET);
    return 1;
}

/* The refusal stub inside the block: "MOV R0, #0; MOV PC, LR". */
static btv_hal_entry *inert_entry(void)
{
    uint32_t *code = (uint32_t *)((uint8_t *)device_block +
                                  DEVICE_CODE_OFFSET);
    register uint32_t r0 __asm("r0") = 1;
    register uint32_t r1 __asm("r1") = (uint32_t)code;
    register uint32_t r2 __asm("r2") = (uint32_t)(code + 2);
    code[0] = 0xe3a00000u;
    code[1] = 0xe1a0f00eu;
    __asm volatile(
        "swi 0x2006e"                  /* XOS_SynchroniseCodeAreas */
        : "+r" (r0), "+r" (r1), "+r" (r2)
        :
        : "cc", "memory", "lr");
    return (btv_hal_entry *)code;
}

static int registered;
static uint32_t consumed;
/* Bring-up meter: loudest sample and buffers holding any sound. */
static uint32_t peak, audible;
static uint32_t test_tone_frames, test_tone_phase;
static unsigned int next_buffer;
static char previous[CONTROLLER_ID_BYTES];
static uint8_t mono[MONO_BYTES];
/* Q15 amplitude for 0 through -40 dB, interpolated at 1/16 dB. */
static const uint16_t mixer_gain[41] = {
    32768, 29205, 26029, 23198, 20675, 18427, 16423, 14637,
    13045, 11627, 10362, 9235, 8231, 7336, 6538, 5827,
    5193, 4629, 4125, 3677, 3277, 2920, 2603, 2320,
    2068, 1843, 1642, 1464, 1305, 1163, 1036, 924,
    823, 734, 654, 583, 519, 463, 413, 368, 328
};

static uint32_t mixer_scale(void)
{
    unsigned int attenuation, whole, fraction;
    if (mixer_block == NULL || mixer_block->mute) return 0;
    if (mixer_block->gain >= 0) return 32768;
    attenuation = (unsigned int)-mixer_block->gain;
    if (attenuation >= 640) return mixer_gain[40];
    whole = attenuation >> 4;
    fraction = attenuation & 15u;
    return (mixer_gain[whole] * (16u - fraction) +
            mixer_gain[whole + 1u] * fraction) >> 4;
}

/* An ID string is "SoundDMA#HAL_" + 4 hex ID digits + "_" + location. */
static const char own_id_tail[] = "_0B70_10000000";

/* OS_Hardware takes its reason code in R8, which -mmodule code uses as its
 * static base, so the call lives in a leaf that preserves R8 itself.
 * In: R0 = device, R1 = reason.  Out: R0 = 1 on success. */
extern int btv_os_hardware(void *device, uint32_t reason);
__asm__(
    "\t.text\n"
    "\t.arm\n"
    "\t.global btv_os_hardware\n"
    "btv_os_hardware:\n"
    "\tstmfd sp!, {r8, lr}\n"
    "\tmov r8, r1\n"
    "\tswi 0x2007a\n"
    "\tmovvc r0, #1\n"
    "\tmovvs r0, #0\n"
    "\tldmfd sp!, {r8, pc}\n");

static int hardware_call(uint32_t reason)
{
    return btv_os_hardware(device_block, reason);
}

/* Sound_EnumerateControllers: after `from` (empty for the first). */
static int next_controller(const char *from, char *output, uint32_t bytes)
{
    register uint32_t r0 __asm("r0") = (uint32_t)from;
    register uint32_t r1 __asm("r1") = (uint32_t)output;
    register uint32_t r2 __asm("r2") = bytes;
    register uint32_t r3 __asm("r3") = 0;
    register uint32_t success __asm("r4");
    __asm volatile(
        "swi 0x60149\n\t"
        "movvc %4, #1\n\t"
        "movvs %4, #0"
        : "+r" (r0), "+r" (r1), "+r" (r2), "+r" (r3), "=r" (success)
        :
        : "cc", "memory", "lr");
    (void)r0; (void)r1; (void)r2; (void)r3;
    return success && output[0] != 0;
}

static void select_controller(const char *id)
{
    register uint32_t r0 __asm("r0") = (uint32_t)id;
    register uint32_t r1 __asm("r1") = 0;
    register uint32_t r2 __asm("r2") = 0;
    register uint32_t r3 __asm("r3") = 0;
    __asm volatile(
        "swi 0x60148"
        : "+r" (r0), "+r" (r1), "+r" (r2), "+r" (r3)
        :
        : "cc", "memory", "lr");
    (void)r0; (void)r1; (void)r2; (void)r3;
}

static int is_own(const char *id)
{
    size_t length = strlen(id), tail = sizeof(own_id_tail) - 1;
    return length >= tail && strcmp(id + length - tail, own_id_tail) == 0;
}

/* SoundDMA has no call that reports the active controller, so the first
 * other controller is the one sound returns to.  On the iMX6 that is the
 * only other one. */
static void remember_previous(void)
{
    char id[CONTROLLER_ID_BYTES];
    id[0] = 0;
    previous[0] = 0;
    while (next_controller(id, id, sizeof(id)))
    {
        if (!is_own(id))
        {
            memcpy(previous, id, sizeof(previous));
            return;
        }
    }
}

static void build_device(void)
{
    memset(device_block, 0, sizeof(*device_block));
    device_block->type = HAL_DEVICE_TYPE_AUDIO_CONTROLLER;
    device_block->id = HAL_DEVICE_ID_BLUETOOTH_HFP;
    device_block->location = HAL_DEVICE_LOCATION;
    device_block->version = HAL_API_2;
    device_block->description = description;
    device_block->activate = &btv_audc_activate;
    device_block->deactivate = &btv_audc_nothing;
    device_block->reset = &btv_audc_nothing;
    device_block->sleep = &btv_audc_zero;
    device_block->device = -1;
    device_block->test_irq = &btv_audc_zero;
    device_block->clear_irq = &btv_audc_nothing;
    device_block->mixer = mixer_block;
    device_block->channels_out = 1;
    device_block->pre_enable = &btv_audc_nothing;
    device_block->post_enable = &btv_audc_nothing;
    device_block->pre_disable = &btv_audc_pre_disable;
    device_block->post_disable = &btv_audc_nothing;
    device_block->irq_handle = &btv_audc_zero;
    device_block->rate_count = 1;
    device_block->rate_table = rates;
    device_block->set_rate = &btv_audc_nothing;
    device_block->custom_dma_enable = &btv_audc_custom_dma_enable;
    device_block->flags = AUDIO_FLAG_STEREO_REVERSE; /* L, R order; callback stays asynchronous */
    device_block->min_buffer_bytes = 64u * 4u;
    device_block->buffer_align = 16u;
}

static void build_mixer(void)
{
    memset(mixer_block, 0, sizeof(*mixer_block));
    mixer_block->type = HAL_DEVICE_TYPE_AUDIO_MIXER;
    mixer_block->id = HAL_DEVICE_ID_SOFTWARE_MIXER;
    mixer_block->location = HAL_DEVICE_LOCATION;
    mixer_block->version = 1u; /* HAL mixer API 0.1 */
    mixer_block->description = mixer_description;
