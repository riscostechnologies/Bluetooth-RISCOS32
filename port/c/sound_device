    mixer_block->get_limits = &btv_mix_limits;
}

static void call_sound_dma(void)
{
    register uint32_t r0 __asm("r0") = 0;
    register uint32_t r1 __asm("r1") = device_block->callback_parameter;
    register uint32_t r2 __asm("r2") = (uint32_t)device_block->callback;
    register uint32_t r3 __asm("r3") = 0;
    register uint32_t r12 __asm("r12") = 0;
    /* The callback may run SoundDMA's fill routine in place (RT_Yield),
     * which corrupts R1-R9, R11 and R12: R8 is this module's static base,
     * and a clobbered R8 sent the buffer loop to a wild address.  Save
     * every callee-saved register, and SL, around the call. */
    __asm volatile(
        "stmfd sp!, {r4-r11}\n\t"
        "mov lr, pc\n\t"
        "mov pc, %2\n\t"
        "ldmfd sp!, {r4-r11}"
        : "+r" (r0), "+r" (r1), "+r" (r2), "+r" (r3), "+r" (r12)
        :
        : "cc", "memory", "lr");
    (void)r0; (void)r1; (void)r2; (void)r3; (void)r12;
}

static void consume(btv_bridge_pcm *pcm)
{
    const int16_t *source = device_block->buffer[next_buffer];
    size_t frames = device_block->buffer_bytes / 4u, index;
    uint32_t scale = mixer_scale();
    if (frames > MONO_BYTES / 2u) frames = MONO_BYTES / 2u;
    unsigned int loudest = 0;
    for (index = 0; index < frames; ++index)
    {
        int sum = (int)source[index * 2u] + (int)source[index * 2u + 1u];
        int sample = (int)(((sum / 2) * (int32_t)scale) >> 15);
        unsigned int level = (unsigned int)(sample < 0 ? -sample : sample);
        if (level > loudest) loudest = level;
        mono[index * 2u] = (uint8_t)sample;
        mono[index * 2u + 1u] = (uint8_t)((unsigned int)sample >> 8);
    }
    if (loudest > peak) peak = loudest;
    if (loudest != 0) ++audible;
    (void)btv_bridge_pcm_write(pcm, mono, frames * 2u);
    next_buffer ^= 1u;
    ++consumed;
    if (in_sound_dma) return;      /* SoundDMA is already inside us */
    in_sound_dma = 1;
    call_sound_dma();
    in_sound_dma = 0;
}

/* Is a controller with our ID in SoundDMA's list? */
static int own_controller_listed(void)
{
    char id[CONTROLLER_ID_BYTES];
    id[0] = 0;
    while (next_controller(id, id, sizeof(id)))
        if (is_own(id)) return 1;
    return 0;
}

static int register_device(void)
{
    static const char prefix[] = "SoundDMA#HAL";
    char id[sizeof(prefix) - 1 + sizeof(own_id_tail)];
    if (!claim_device_block()) return 0;
    /* A controller with our ID that we did not add belongs to a previous
     * instance of this module whose workspace is gone.  SoundDMA would
     * abort the moment it touched either device, so leave well alone. */
    if (own_controller_listed())
    {
        stale_entry = 1;
        return 0;
    }
    build_device();
    if (!mixer_registered) build_mixer();
    remember_previous();
    next_buffer = 0;
    consumed = 0;
    if (!hardware_call(OS_HARDWARE_ADD_DEVICE)) return 0;
    registered = 1;
    if (!mixer_registered)
    {
        if (!btv_os_hardware(mixer_block, OS_HARDWARE_ADD_DEVICE))
        {
            (void)hardware_call(OS_HARDWARE_REMOVE_DEVICE);
            registered = 0;
            return 0;
        }
        mixer_registered = 1;
    }
    /* SoundDMA adopts a new device on its own only when it has none. */
    memcpy(id, prefix, sizeof(prefix) - 1);
    memcpy(id + sizeof(prefix) - 1, own_id_tail, sizeof(own_id_tail));
    select_controller(id);
    return 1;
}

static int unregister_device(void)
{
    /* Hand sound back to the machine's own controller BEFORE leaving the
     * device list.  Removing the selected controller makes SoundDMA
     * disable sound and adopt another from inside the service call, with
     * our entries being called while the stream is still live; that path
     * aborted inside SoundDMA (&FC052230) and took the machine with it.
     * Switching first leaves our device idle, so removing it is quiet. */
    if (previous[0] != 0) select_controller(previous);
    /* If the removal fails we must stay registered: SoundDMA would keep a
     * pointer to this device block, and reading it after the module is
     * killed aborts inside SoundDMA, with sound dead until a reboot. */
    if (!hardware_call(OS_HARDWARE_REMOVE_DEVICE)) return 0;
    /* Trust nothing: if SoundDMA still lists the device, stay registered
     * so the module refuses to be killed. */
    if (own_controller_listed()) return 0;
    registered = 0;
    device_block->running = 0;
    if (mixer_registered &&
        btv_os_hardware(mixer_block, OS_HARDWARE_REMOVE_DEVICE))
        mixer_registered = 0;
    return 1;
}

static int buffers_ready(void)
{
    return device_block != NULL && device_block->running && device_block->callback != NULL &&
           device_block->buffer[0] != NULL && device_block->buffer[1] != NULL;
}

void btv_sound_device_sync(btv_bridge_pcm *pcm, int active)
{
    unsigned int count;
    if (active && !registered)
    {
        stereo_mode = 0;
        description = hfp_description;
        rates[0].frequency = 8000u * 1024u;
        rates[0].period = 125;
        if (!register_device()) return;
    }
    else if (!active && registered && !stereo_mode)
    {
        (void)unregister_device();
        return;
    }
    if (!registered || stereo_mode || pcm == NULL) return;
    for (count = 0; count < MAX_BUFFERS_PER_PUMP; ++count)
    {
        if (!buffers_ready() || pcm->playback.used > LOW_WATER_BYTES)
            break;
        consume(pcm);
    }
}

static void consume_stereo(void)
{
    const int16_t *source = device_block->buffer[next_buffer];
    unsigned int frames = device_block->buffer_bytes >> 2, index, loudest = 0;
    uint32_t scale = mixer_scale();
    for (index = 0; index < frames && ring_used < RING_FRAMES; ++index)
    {
        unsigned int slot = (ring_head + ring_used) & (RING_FRAMES - 1u);
        int left = (int)((source[index * 2u] * (int32_t)scale) >> 15);
        int right = (int)((source[index * 2u + 1u] * (int32_t)scale) >> 15);
        if (test_tone_frames != 0)
        {
            left = right = (test_tone_phase++ / 55u) & 1u ? 8000 : -8000;
            --test_tone_frames;
        }
        unsigned int level = (unsigned int)(left < 0 ? -left : left);
        if (level > loudest) loudest = level;
        ring[slot * 2u] = (int16_t)left;
        ring[slot * 2u + 1u] = (int16_t)right;
        ++ring_used;
    }
    if (loudest > peak) peak = loudest;
    if (loudest != 0) ++audible;
    next_buffer ^= 1u;
    ++consumed;
    if (in_sound_dma) return;      /* SoundDMA is already inside us */
    in_sound_dma = 1;
    call_sound_dma();
    in_sound_dma = 0;
}

/* Milliseconds of audio in one SoundDMA buffer, rounded down. */
/* Frames in one SoundDMA buffer (stereo, 16-bit). */
static uint32_t buffer_frames(void)
{
    return device_block == NULL ? 0u : device_block->buffer_bytes >> 2;
}

static void pump_stereo(void)
{
    unsigned int count;
    uint32_t frames = buffer_frames();
    if (frames != 0 && !stereo_pace.primed)
        btv_sound_pace_start(&stereo_pace, frames, STEREO_PRIME_BUFFERS);
    for (count = 0; count < MAX_BUFFERS_PER_PUMP; ++count)
    {
        if (!buffers_ready() || ring_used >= STEREO_LOW_WATER ||
            ring_used + frames > RING_FRAMES)
            break;
        /* Only take what has had time to be filled. */
        if (frames != 0)
        {
            if (!btv_sound_pace_take(&stereo_pace, frames)) break;
        }
        else if (count >= STEREO_PRIME_BUFFERS) break;
        consume_stereo();
    }
    /* A full ring means the sink is not draining: do not bank credit for
     * a burst of stale buffers later. */
    if (ring_used >= STEREO_LOW_WATER) btv_sound_pace_idle(&stereo_pace);
}

int btv_sound_device_stereo_sync(int active, uint32_t rate, uint32_t now)
{
    if (active && registered && stereo_mode)
    {
        uint32_t elapsed = now - stereo_clock;
        stereo_clock = now;
        btv_sound_pace_tick(&stereo_pace, elapsed, stereo_rate,
                            buffer_frames(), STEREO_PRIME_BUFFERS * 4u);
    }
    if (active && !registered)
    {
        stereo_mode = 1;
        stereo_rate = rate;
        stereo_clock = now;
        /* Prime the ring so the encoder has something before the clock
         * has earned a buffer. */
        btv_sound_pace_start(&stereo_pace, buffer_frames(),
                             STEREO_PRIME_BUFFERS);
        description = a2dp_description;
        rates[0].frequency = rate * 1024u;
        rates[0].period = (uint8_t)(rate >= 48000u ? 21 : 23);
        ring_head = ring_used = 0;
        if (!register_device()) return 0;
    }
    else if (!active && registered && stereo_mode)
    {
        if (!unregister_device()) return 1;   /* still registered */
        stereo_mode = 0;
        return 0;
    }
    if (registered && stereo_mode) pump_stereo();
    return registered && stereo_mode;
}

unsigned int btv_sound_device_stereo_read(int16_t *output,
                                          unsigned int frames)
{
    unsigned int index, copied = 0;
    if (!registered || !stereo_mode) return 0;
    pump_stereo();
    for (index = 0; index < frames && ring_used != 0; ++index)
    {
        output[index * 2u] = ring[ring_head * 2u];
        output[index * 2u + 1u] = ring[ring_head * 2u + 1u];
        ring_head = (ring_head + 1u) & (RING_FRAMES - 1u);
        --ring_used;
        ++copied;
    }
    return copied;
}

/* Leave a device the kernel can walk and no one can use.  Only for a
 * finalisation this module cannot refuse: the alternative is a list node
 * pointing at code that has gone, which aborts inside the kernel. */
void btv_sound_device_orphan(void)
{
    btv_hal_entry *inert;
    if ((!registered && !mixer_registered) || device_block == NULL) return;
    inert = inert_entry();
    if (mixer_registered)
    {
        mixer_block->activate = inert;
        mixer_block->deactivate = inert;
        mixer_block->reset = inert;
        mixer_block->sleep = inert;
        mixer_block->test_irq = inert;
        mixer_block->clear_irq = inert;
        mixer_block->get_features = inert;
        mixer_block->set_mix = inert;
        mixer_block->get_mix = inert;
        mixer_block->get_limits = inert;
        mixer_block->description = (const char *)device_block + DEVICE_NAME_OFFSET;
    }
    device_block->activate = inert;
    device_block->deactivate = inert;
    device_block->reset = inert;
    device_block->sleep = inert;
    device_block->test_irq = inert;
    device_block->clear_irq = inert;
    device_block->pre_enable = inert;
    device_block->post_enable = inert;
    device_block->pre_disable = inert;
    device_block->post_disable = inert;
    device_block->irq_handle = inert;
    device_block->set_rate = inert;
    device_block->custom_dma_enable = inert;
    device_block->rate_table = NULL;
    device_block->rate_count = 0;
    /* The name must live in the block too: SoundDMA reads it when
     * anything lists the sound controllers. */
    {
        char *name = (char *)device_block + DEVICE_NAME_OFFSET;
        strcpy(name, "Bluetooth (stopped)");
        device_block->description = name;
    }
    device_block->running = 0;
}

uint32_t btv_sound_device_state(void)
{
    if (device_block == NULL) return stale_entry ? 4u : 0u;
    return (registered ? 1u : 0u) | (device_block->running ? 2u : 0u) |
           (stale_entry ? 4u : 0u) | (consumed << 8);
}

uint32_t btv_sound_device_meter(void)
{
    uint32_t value = (peak > 0xffffu ? 0xffffu : peak) |
                     ((audible > 0xffffu ? 0xffffu : audible) << 16);
    peak = 0;
    return value;
}

int btv_sound_device_test_tone(uint32_t milliseconds)
{
    if (!registered || !stereo_mode || milliseconds == 0) return 0;
    if (milliseconds > 5000u) milliseconds = 5000u;
    test_tone_phase = 0;
    test_tone_frames = milliseconds * (stereo_rate / 1000u);
    return 1;
}

int btv_sound_device_registered(void)
{
    return registered || mixer_registered;
}

int btv_sound_device_running(void)
{
    return registered && device_block != NULL && device_block->running;
}

