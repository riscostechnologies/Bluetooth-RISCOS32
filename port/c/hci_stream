/*******************************************************************
 * File:        hci_stream
 * Purpose:     Bounded packet assembly for the RISC OS Bluetooth transport.
 * Reference:   Packet sizes from the pinned NetBSD hci.h via hci_frame.
 *              Original implementation; no NetBSD kernel/mbuf dependency.
 ******************************************************************/
#include "hci_stream.h"
#include <string.h>

int btv_hci_stream_init(btv_hci_stream *stream, unsigned int type,
                        uint8_t *storage, size_t capacity)
{
    size_t header;
    if (type == BTV_HCI_EVENT) header = 2;
    else if (type == BTV_HCI_SCO || type == BTV_HCI_COMMAND) header = 3;
    else if (type == BTV_HCI_ACL) header = 4;
    else return 0;
    if (stream == NULL || storage == NULL || capacity < header)
        return 0;
    stream->storage = storage;
    stream->capacity = capacity;
    stream->header = header;
    stream->type = type;
    btv_hci_stream_restart(stream);
    return 1;
}

void btv_hci_stream_restart(btv_hci_stream *stream)
{
    if (stream != NULL)
    {
        stream->used = 0;
        stream->expected = 0;
        stream->lost = 0;
    }
}

void btv_hci_stream_loss(btv_hci_stream *stream)
{
    if (stream != NULL)
    {
        stream->used = 0;
        stream->expected = 0;
        stream->lost = 1;
    }
}

const uint8_t *btv_hci_stream_packet(const btv_hci_stream *stream, size_t *bytes)
{
    if (bytes == NULL) return NULL;
    *bytes = 0;
    if (stream == NULL || stream->lost || stream->expected == 0 ||
        stream->used != stream->expected)
        return NULL;
    *bytes = stream->used;
    return stream->storage;
}

int btv_hci_stream_take(btv_hci_stream *stream)
{
    size_t bytes;
    if (btv_hci_stream_packet(stream, &bytes) == NULL)
        return 0;
    btv_hci_stream_restart(stream);
    return 1;
}

int btv_hci_stream_feed(btv_hci_stream *stream, const uint8_t *input,
                        size_t bytes, size_t *consumed)
{
    size_t amount;
    int result;
    if (consumed == NULL) return BTV_HCI_INVALID;
    *consumed = 0;
    if (stream == NULL || (input == NULL && bytes != 0) || stream->lost)
        return BTV_HCI_INVALID;
    if (stream->used < stream->header)
    {
        amount = stream->header - stream->used;
        if (amount > bytes) amount = bytes;
        if (amount != 0)
            memcpy(stream->storage + stream->used, input, amount);
        stream->used += amount;
        *consumed += amount;
        if (stream->used < stream->header) return BTV_HCI_MORE;
    }
    if (stream->expected == 0)
    {
        result = btv_hci_frame_size(stream->type, stream->storage, stream->used,
                                    stream->capacity - stream->header,
                                    &stream->expected);
        if (result == BTV_HCI_INVALID)
        {
            btv_hci_stream_loss(stream);
            return BTV_HCI_INVALID;
        }
    }
    amount = stream->expected - stream->used;
    if (amount > bytes - *consumed) amount = bytes - *consumed;
    if (amount != 0)
        memcpy(stream->storage + stream->used, input + *consumed, amount);
    stream->used += amount;
    *consumed += amount;
    return stream->used == stream->expected ? BTV_HCI_COMPLETE : BTV_HCI_MORE;
}
