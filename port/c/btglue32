/* One extra pump about a centisecond from now (OS_CallAfter), on top of the
 * 2 cs ticker.  The USB transport sends one ACL packet per USB transfer and
 * learns that it has gone only at the next pump, so the ticker alone let
 * out about 50 packets a second.  The routine is the ticker's own: it
 * queues the callback unless one is already pending.  bt_drive_stop's
 * OS_RemoveTickerEvent removes a pending one too (same code and R12). */
static uint32_t after_pending;

void bt_drive_soon(void)
{
    if (after_pending) return;
    {
        register uint32_t r0 __asm("r0") = 1u;     /* 1 cs */
        register uint32_t r1 __asm("r1") = (uint32_t)&btm_ticker;
        register uint32_t r2 __asm("r2") = (uint32_t)&drive;
        register uint32_t ok __asm("r3");
        __asm volatile("swi 0x2003b\n\t"           /* XOS_CallAfter */
                       "movvc %3, #1\n\t"
                       "movvs %3, #0"
                       : "+r" (r0), "+r" (r1), "+r" (r2), "=r" (ok)
                       : : "cc", "memory", "lr");
        (void)r0; (void)r1; (void)r2;
        if (ok) after_pending = 1;
    }
}

/* Called at the start of every pump: the call-after has fired (or the
 * ticker got there first; either way a new one may be asked for). */
void bt_drive_soon_done(void)
{
    after_pending = 0;
}
