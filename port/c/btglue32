/*
 * btglue32: the 64-bit core's platform calls (btglue.c there) for the
 * 32-bit module: the clock, and the ticker that queues a transient callback
 * which pumps the core.  The ticker and veneer are the 32-bit build's own
 * (BluetoothVoice 0.6x module_core), moved here unchanged.
 */
#include <stddef.h>
#include <stdint.h>

#define CORE_TICK_CS 2u     /* OS_CallEvery takes interval - 1; 0 is refused */

void btm_callback(void);

/* +0 callback pending, +4 private word pointer, +8 callback veneer,
 * +12 ticks seen, +16 callbacks queued. */
static struct
{
    uint32_t pending;
    void *pw;
    void (*veneer)(void);
    uint32_t ticks, queued;
} drive;

extern void btm_ticker(void);
extern void btm_callback_veneer(void);

__asm__(
    "\t.text\n"
    "\t.arm\n"
    "\t.global btm_ticker\n"
    "btm_ticker:\n"
    "\tstmfd sp!, {r0-r3, lr}\n"
    "\tldr r0, [r12, #12]\n"
    "\tadd r0, r0, #1\n"
    "\tstr r0, [r12, #12]\n"
    "\tldr r0, [r12, #0]\n"
    "\tcmp r0, #0\n"
    "\tbne 1f\n"
    "\tmov r0, #1\n"
    "\tstr r0, [r12, #0]\n"
    "\tldr r0, [r12, #8]\n"
    "\tmov r1, r12\n"
    "\tswi 0x20054\n"
    "\tldr r0, [r12, #16]\n"
    "\tadd r0, r0, #1\n"
    "\tstr r0, [r12, #16]\n"
    "1:\n"
    "\tldmfd sp!, {r0-r3, pc}\n"
    "\t.global btm_callback_veneer\n"
    "btm_callback_veneer:\n"
    "\tstmfd sp!, {r0-r11, lr}\n"
    "\tmov r0, #0\n"
    "\tstr r0, [r12, #0]\n"
    "\tmov r4, r12\n"
    "\tmov sl, sp, lsr #20\n"
    "\tmov sl, sl, lsl #20\n"
    "\tldmia sl, {r5, r6}\n"
    "\tldr ip, [r4, #4]\n"
    "\tldr ip, [ip]\n"
    "\tldmib ip, {fp, ip}\n"
    "\tstmia sl, {fp, ip}\n"
    "\tadd sl, sl, #540\n"
    "\tmov fp, #0\n"
    "\tbl btm_callback\n"
    "\tsub sl, sl, #540\n"
    "\tstmia sl, {r5, r6}\n"
    "\tldmfd sp!, {r0-r11, pc}\n");

void bt_glue_init(void *pw)
{
    drive.pw = pw;
}

uint32_t bt_now_ms(void)
{
    register uint32_t value __asm("r0");
    __asm volatile("swi 0x42" : "=r" (value) : : "cc", "lr");
    return value * 10u;
}

int bt_drive_start(void)
{
    register uint32_t r0 __asm("r0") = CORE_TICK_CS - 1u;
    register uint32_t r1 __asm("r1") = (uint32_t)&btm_ticker;
    register uint32_t r2 __asm("r2") = (uint32_t)&drive;
    register uint32_t r3 __asm("r3") = 0;
    register uint32_t success __asm("r4");
    drive.veneer = &btm_callback_veneer;
    drive.pending = 0;
    __asm volatile(
        "swi 0x2003c\n\t"
        "movvc %4, #1\n\t"
        "movvs %4, #0"
        : "+r" (r0), "+r" (r1), "+r" (r2), "+r" (r3), "=r" (success)
        :
        : "cc", "memory", "lr");
    (void)r0; (void)r1; (void)r2; (void)r3;
    return (int)success;
}

void bt_drive_stop(void)
{
    {
        register uint32_t r0 __asm("r0") = (uint32_t)&btm_ticker;
        register uint32_t r1 __asm("r1") = (uint32_t)&drive;
        register uint32_t r2 __asm("r2") = 0;
        register uint32_t r3 __asm("r3") = 0;
        __asm volatile("swi 0x2003d"
                       : "+r" (r0), "+r" (r1), "+r" (r2), "+r" (r3)
                       : : "cc", "memory", "lr");
        (void)r0; (void)r1; (void)r2; (void)r3;
    }
    {
        register uint32_t r0 __asm("r0") = (uint32_t)&btm_callback_veneer;
        register uint32_t r1 __asm("r1") = (uint32_t)&drive;
        register uint32_t r2 __asm("r2") = 0;
        register uint32_t r3 __asm("r3") = 0;
        __asm volatile("swi 0x2005f"
                       : "+r" (r0), "+r" (r1), "+r" (r2), "+r" (r3)
                       : : "cc", "memory", "lr");
        (void)r0; (void)r1; (void)r2; (void)r3;
    }
    drive.pending = 0;
}

