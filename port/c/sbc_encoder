     -4456,  -3486,  -2561,  -1711,   -959,   -322,    192,    580,
       848,   1004,   1063,   1042,    960,    835,    685,    526,
      -371,   -229,   -108,    -12,     59,    106,    131,    138,
       132,    117,     97,     75,     54,     36,     22,     10
