/*******************************************************************
 * File:        sbc_encoder
 * Purpose:     Fixed-point A2DP SBC encoder (analysis, scale factors,
 *              joint stereo, bit allocation, quantisation, packing).
 * Reference:   A2DP 1.3 Appendix B. Integer only: 32-bit products,
 *              shifts for every division, no compiler helpers.
 ******************************************************************/
#include "sbc_encoder.h"
#include <string.h>

/* Subband samples carry 14 fractional bits (Q14 PCM units): the window
 * is applied at Q15/Q16, folded pairs are rounded to Q2 and the Q13
 * cosine matrix gives Q15, halved once. The peak analysis gain is 1.6,
 * so every accumulator stays below 2^31 for any 16-bit input. */
#define BTV_SBC_FRACTION 14
#define BTV_SBC_FOLD4_SHIFT 13  /* Q15 window -> Q2 */
#define BTV_SBC_FOLD8_SHIFT 14  /* Q16 window -> Q2 */

/* Prototype window C[i] of the specification, Q15. */
static const int16_t btv_sbc_proto4[40] =
{
         0,     18,     49,     90,    126,    128,     61,   -100,
       358,    670,    946,   1055,    848,    201,   -944,  -2544,
      4443,   6389,   8082,   9235,   9644,   9235,   8082,   6389,
     -4443,  -2544,   -944,    201,    848,   1055,    946,    670,
      -358,   -100,     61,    128,    126,     90,     49,     18
};

