/* Adapted from NetBSD hci_unit.c command queuing/credit handling and
 * hci_event.c command response dispatch. Bounded copies and stable tickets
 * replace mbufs; separate USB completion tracking prevents premature reuse. */
#include "hci_commands.h"
#include "hci_frame.h"
#include <string.h>

static uint16_t read16(const uint8_t *p)
{
    return (uint16_t)((uint16_t)p[0] | ((uint16_t)p[1] << 8));
}

static btv_command_slot *find(btv_hci_commands *commands, uint32_t ticket)
{
    unsigned int i;
    if (ticket == 0) return NULL;
    for (i = 0; i < BTV_COMMAND_SLOTS; ++i)
        if (commands->slots[i].ticket == ticket) return &commands->slots[i];
    return NULL;
}

static int eligible(const btv_hci_commands *commands, const btv_command_slot *slot)
{
    unsigned int i;
    if (slot->ticket == 0 || slot->submitted || commands->credits == 0 || commands->recovery) return 0;
    for (i = 0; i < BTV_COMMAND_SLOTS; ++i)
        if (commands->slots[i].ticket != 0 && commands->slots[i].submitted &&
            !commands->slots[i].event_done && commands->slots[i].opcode == slot->opcode) return 0;
    return 1;
}

void btv_hci_commands_init(btv_hci_commands *commands, uint8_t credits)
{
    memset(commands, 0, sizeof(*commands));
    commands->credits = credits;
    commands->next_ticket = 1;
}

int btv_hci_commands_queue(btv_hci_commands *commands, const uint8_t *packet, size_t bytes,
                           unsigned int expected_event, uint32_t *ticket)
{
    size_t expected;
    unsigned int i;
    btv_command_slot *slot;
    if (commands->recovery) return BTV_COMMAND_RECOVER;
    if (ticket == NULL || (expected_event != BTV_COMMAND_COMPLETE && expected_event != BTV_COMMAND_STATUS) ||
        btv_hci_frame_size(BTV_HCI_COMMAND, packet, bytes, 255, &expected) != BTV_HCI_COMPLETE ||
        expected != bytes || read16(packet) == 0) return BTV_COMMAND_INVALID;
    if (commands->next_ticket == 0) return BTV_COMMAND_TICKETS_EXHAUSTED;
    for (i = 0; i < BTV_COMMAND_SLOTS; ++i)
        if (commands->slots[i].ticket == 0)
        {
            slot = &commands->slots[i];
            memset(slot, 0, sizeof(*slot));
            memcpy(slot->command, packet, bytes);
            slot->opcode = read16(packet);
            slot->command_bytes = (uint16_t)bytes;
            slot->expected_event = (uint8_t)expected_event;
            slot->ticket = commands->next_ticket++;
            *ticket = slot->ticket;
            return BTV_COMMAND_OK;
        }
    return BTV_COMMAND_FULL;
}

size_t btv_hci_commands_peek(const btv_hci_commands *commands, uint8_t *output, size_t capacity, uint32_t *ticket)
{
    const btv_command_slot *selected;
    unsigned int i;
    selected = NULL;
    if (output == NULL || ticket == NULL) return 0;
    for (i = 0; i < BTV_COMMAND_SLOTS; ++i)
        if (eligible(commands, &commands->slots[i]) &&
            (selected == NULL || commands->slots[i].ticket < selected->ticket)) selected = &commands->slots[i];
    if (selected == NULL || selected->command_bytes > capacity) return 0;
    memcpy(output, selected->command, selected->command_bytes);
    *ticket = selected->ticket;
    return selected->command_bytes;
}

int btv_hci_commands_sent(btv_hci_commands *commands, uint32_t ticket)
{
    btv_command_slot *slot;
    if (commands->recovery) return BTV_COMMAND_RECOVER;
    slot = find(commands, ticket);
    if (slot == NULL || !eligible(commands, slot)) return BTV_COMMAND_INVALID;
    slot->submitted = 1;
    --commands->credits;
    return BTV_COMMAND_OK;
}

void btv_hci_commands_abort(btv_hci_commands *commands)
{
    commands->recovery = 1;
}

int btv_hci_commands_usb_done(btv_hci_commands *commands, uint32_t ticket, int success)
{
    btv_command_slot *slot;
    slot = find(commands, ticket);
    if (slot == NULL || !slot->submitted || slot->usb_done) return BTV_COMMAND_INVALID;
    slot->usb_done = 1;
    if (!success) btv_hci_commands_abort(commands);
    return commands->recovery ? BTV_COMMAND_RECOVER : BTV_COMMAND_OK;
}

int btv_hci_commands_event(btv_hci_commands *commands, const uint8_t *packet, size_t bytes)
{
    size_t expected;
    uint16_t opcode;
    uint8_t credits;
    unsigned int i;
    btv_command_slot *slot;
    if (commands->recovery) return BTV_COMMAND_RECOVER;
    if (btv_hci_frame_size(BTV_HCI_EVENT, packet, bytes, 255, &expected) != BTV_HCI_COMPLETE || expected != bytes)
        goto bad;
    if (packet[0] == 0x10) goto bad;
    if (packet[0] == BTV_COMMAND_COMPLETE)
    {
        if (bytes < 5) goto bad;
        credits = packet[2]; opcode = read16(packet + 3);
    }
    else if (packet[0] == BTV_COMMAND_STATUS)
    {
        if (bytes != 6) goto bad;
        credits = packet[3]; opcode = read16(packet + 4);
    }
    else return BTV_COMMAND_WAIT;
    commands->credits = credits;
    for (i = 0; i < BTV_COMMAND_SLOTS; ++i)
    {
        slot = &commands->slots[i];
        if (slot->ticket == 0 || !slot->submitted || slot->event_done || slot->opcode != opcode) continue;
        if (packet[0] != slot->expected_event)
        {
            if (packet[0] != BTV_COMMAND_STATUS) goto bad;
            if (packet[2] == 0) return BTV_COMMAND_WAIT;
        }
        memcpy(slot->event, packet, bytes);
        slot->event_bytes = (uint16_t)bytes;
        slot->event_done = 1;
        return BTV_COMMAND_OK;
    }
    return BTV_COMMAND_WAIT;
bad:
    btv_hci_commands_abort(commands);
    return BTV_COMMAND_RECOVER;
}

int btv_hci_commands_reply(btv_hci_commands *commands, uint32_t ticket, btv_command_reply *reply)
{
    btv_command_slot *slot;
    if (commands->recovery) return BTV_COMMAND_RECOVER;
    slot = find(commands, ticket);
    if (slot == NULL || reply == NULL) return BTV_COMMAND_INVALID;
    if (!slot->usb_done || !slot->event_done) return BTV_COMMAND_WAIT;
    memset(reply, 0, sizeof(*reply));
    reply->ticket = ticket;
    reply->opcode = slot->opcode;
    reply->bytes = slot->event_bytes;
    memcpy(reply->event, slot->event, slot->event_bytes);
    slot->ticket = 0;
    return BTV_COMMAND_OK;
}

int btv_hci_commands_cancel(btv_hci_commands *commands, uint32_t ticket)
{
    btv_command_slot *slot;
    slot = find(commands, ticket);
    if (slot == NULL) return BTV_COMMAND_INVALID;
    if (slot->submitted) return BTV_COMMAND_INVALID;
    slot->ticket = 0;
    return BTV_COMMAND_OK;
}

int btv_hci_commands_drained(const btv_hci_commands *commands)
{
    unsigned int i;
    for (i = 0; i < BTV_COMMAND_SLOTS; ++i)
        if (commands->slots[i].ticket != 0 && commands->slots[i].submitted && !commands->slots[i].usb_done) return 0;
    return 1;
}
