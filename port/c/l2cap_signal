/* Classic L2CAP signaling wire boundary. Wire layout follows the pinned
 * NetBSD sys/netbt/l2cap.h; independent bounded-buffer implementation.
 * Deliberately separate from channel negotiation and request ownership. */
#include "l2cap_signal.h"
#include <string.h>

static unsigned int read16(const uint8_t *p)
{
    return (unsigned int)p[0] | ((unsigned int)p[1] << 8);
}

static void write16(uint8_t *p, size_t value)
{
    p[0] = (uint8_t)value;
    p[1] = (uint8_t)(value >> 8);
}

static int options_valid(const uint8_t *p, size_t bytes)
{
    size_t length;
    while (bytes != 0)
    {
        if (bytes < 2)
            return 0;
        length = p[1];
        if (length > bytes - 2)
            return 0;
        p += length + 2;
        bytes -= length + 2;
    }
    return 1;
}

static int parameters_valid(uint8_t code, const uint8_t *p, size_t bytes)
{
    unsigned int reason;
    switch (code)
    {
        case 1: /* Command Reject: reason-specific extra data. */
            if (bytes < 2)
                return 0;
            reason = read16(p);
            if (reason == 0)
                return bytes == 2;
            if (reason == 1)
                return bytes == 4;
            if (reason == 2)
                return bytes == 6;
            return 1; /* Future reason; owner decides policy. */
        case 2: /* Connection Request */
        case 6: /* Disconnection Request */
        case 7: /* Disconnection Response */
            return bytes == 4;
        case 3: /* Connection Response */
            return bytes == 8;
        case 4: /* Configuration Request */
            return bytes >= 4 && options_valid(p + 4, bytes - 4);
        case 5: /* Configuration Response */
            return bytes >= 6 && options_valid(p + 6, bytes - 6);
        case 10: /* Information Request */
            return bytes == 2;
        case 11: /* Information Response, type-specific data belongs to owner. */
            return bytes >= 4;
        default: /* Echo and unknown commands contain arbitrary bytes. */
            return 1;
    }
}

int btv_l2cap_signal_open(btv_l2cap_signal *signal,
                          const uint8_t *pdu, size_t bytes)
{
    size_t offset, length;
    btv_l2cap_signal result;
    if (signal == NULL || pdu == NULL || bytes < 4 || bytes - 4 > 65535U ||
        read16(pdu) != bytes - 4)
        return -1;
    if (read16(pdu + 2) != 1)
        return 0;
    offset = 4;
    if (bytes == offset)
        return -1;
    while (offset < bytes)
    {
        if (bytes - offset < 4 || pdu[offset + 1] == 0)
            return -1;
        length = read16(pdu + offset + 2);
        if (length > bytes - offset - 4 ||
            !parameters_valid(pdu[offset], pdu + offset + 4, length))
            return -1;
        offset += length + 4;
    }
    result.data = pdu;
    result.bytes = bytes;
    result.offset = 4;
    *signal = result;
    return 1;
}

int btv_l2cap_signal_next(btv_l2cap_signal *signal,
                          btv_l2cap_command *command)
{
    btv_l2cap_command result;
    const uint8_t *p;
    size_t remaining;
    if (signal == NULL || command == NULL || signal->data == NULL ||
        signal->offset < 4 || signal->offset > signal->bytes)
        return -1;
    remaining = signal->bytes - signal->offset;
    if (remaining == 0)
        return 0;
    if (remaining < 4)
        return -1;
    p = signal->data + signal->offset;
    result.bytes = read16(p + 2);
    if (result.bytes > remaining - 4 || p[1] == 0 ||
        !parameters_valid(p[0], p + 4, result.bytes))
        return -1;
    result.code = p[0];
    result.identifier = p[1];
    result.parameters = p + 4;
    signal->offset += result.bytes + 4;
    *command = result;
    return 1;
}

size_t btv_l2cap_signal_encode(uint8_t *output, size_t capacity,
                              uint8_t code, uint8_t identifier,
                              const uint8_t *parameters, size_t bytes)
{
    if (output == NULL || identifier == 0 || bytes > 65531U ||
        (bytes != 0 && parameters == NULL) || capacity < bytes + 8 ||
        !parameters_valid(code, parameters, bytes))
        return 0;
    write16(output, bytes + 4);
    write16(output + 2, 1);
    output[4] = code;
    output[5] = identifier;
    write16(output + 6, bytes);
    if (bytes != 0)
        memcpy(output + 8, parameters, bytes);
    return bytes + 8;
}
