/*******************************************************************
 * File:        bt_sdp_server
 * Purpose:     A minimal SDP server for the Bluetooth core.  Speakers
 *              look up the source's records before they answer AVDTP and
 *              AVCTP, so three are published: the A2DP "Audio Source", and
 *              the two AVRCP roles (Controller, which sets a speaker's
 *              absolute volume, and Target, which takes its volume buttons).
 *              A device that reads the records with ServiceSearch,
 *              ServiceAttribute or ServiceSearchAttribute gets each one
 *              that has every UUID of its search pattern.
 ******************************************************************/
#include "bt_core.h"
#include <string.h>

/* A service record: (attribute id, value) pairs in data element form,
 * ascending by id. */

