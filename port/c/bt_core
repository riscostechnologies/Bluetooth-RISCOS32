static uint32_t last_beat;

/* The bring-up on the HAL debug channel: "[bt] core: <what> <hex>". */
/* Milliseconds at module initialisation: the zero of the boot timings. */
uint32_t btc_origin_ms;

/* Set by the module while timing polls (Bluetooth$Trace): told each stage
 * of btc_pump as it begins. */
void (*btc_stage_hook)(unsigned int stage);
#define STAGE(n) do { if (btc_stage_hook) btc_stage_hook(n); } while (0)

void btc_note(const char *what, uint32_t value)
{
    static const char digits[] = "0123456789abcdef";
    char text[96];
    unsigned int i = 0, shift;
    while (what[i] != 0 && i < 80) { text[i] = what[i]; ++i; }
    text[i++] = ' ';
    for (shift = 32; shift != 0; shift -= 4)
        text[i++] = digits[(value >> (shift - 4)) & 15u];
    text[i] = 0;
    btv_host_bridge_note("core: ", text);
}

