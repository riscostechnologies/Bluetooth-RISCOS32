/* Bounded-buffer adaptation of NetBSD libbluetooth/sdp_data.c element sizing
 * and validation. Length arithmetic precedes pointer formation. */
#include "sdp_data.h"

int btv_sdp_element_read(const uint8_t *data, size_t bytes, btv_sdp_element *element)
{
    btv_sdp_element result;
    unsigned int type, size, i, extra;
    uint32_t length;
    size_t header;
    if (data == NULL || element == NULL || bytes == 0)
        return 0;
    type = data[0] & 0xf8;
    size = data[0] & 7;
    header = 1;
    length = 0;
    if (type == 0)
    {
        if (size != 0)
            return 0;
    }
    else if (type == 8 || type == 16)
    {
        if (size > 4)
            return 0;
        length = (uint32_t)1 << size;
    }
    else if (type == 24)
    {
        if (size != 1 && size != 2 && size != 4)
            return 0;
        length = (uint32_t)1 << size;
    }
    else if (type == 40)
    {
        if (size != 0)
            return 0;
        length = 1;
    }
    else if (type == 32 || type == 48 || type == 56 || type == 64)
    {
        if (size < 5)
            return 0;
        extra = 1U << (size - 5);
        if (bytes - 1 < extra)
            return 0;
        for (i = 0; i < extra; ++i)
            length = (length << 8) | data[1 + i];
        header += extra;
    }
    else
        return 0;
    if (length > bytes - header)
        return 0;
    result.descriptor = data[0];
    result.data = data + header;
    result.bytes = (size_t)length;
    result.total = header + (size_t)length;
    *element = result;
    return 1;
}

static int validate(const uint8_t *data, size_t bytes, unsigned int depth,
                    unsigned int *nodes, size_t *total)
{
    btv_sdp_element element;
    size_t offset, used;
    unsigned int type;
    if (++*nodes > 4096 || !btv_sdp_element_read(data, bytes, &element))
        return 0;
    type = element.descriptor & 0xf8;
    if (type == 48 || type == 56)
    {
        if (depth >= 16)
            return 0;
        offset = 0;
        while (offset < element.bytes)
        {
            if (!validate(element.data + offset, element.bytes - offset, depth + 1, nodes, &used))
                return 0;
            offset += used;
        }
    }
    *total = element.total;
    return 1;
}

int btv_sdp_data_valid(const uint8_t *data, size_t bytes)
{
    unsigned int nodes;
    size_t total;
    nodes = 0;
    return validate(data, bytes, 0, &nodes, &total) && total == bytes;
}
