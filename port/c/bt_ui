#include <string.h>

uint32_t btui_pack_summary(const bt_ui_summary *s)
{
    return (s->state & BTUI_STATE_MASK) |
           (s->scanning ? BTUI_SCANNING : 0) |
           (s->prompt ? BTUI_PROMPT : 0) |
           ((s->audio & 7u) << BTUI_AUDIO_SHIFT) |
           (s->reconnecting ? BTUI_RECONNECTING : 0) |
           (s->connected ? BTUI_CONNECTED : 0) |
           (s->power_wanted ? BTUI_POWER_WANTED : 0) |
           (s->settings_read ? BTUI_SETTINGS_READ : 0);
}

void btui_unpack_summary(uint32_t p, uint32_t generation, uint32_t problem,
                         bt_ui_summary *s)
{
    s->state = p & BTUI_STATE_MASK;
    s->scanning = (p & BTUI_SCANNING) != 0;
    s->prompt = (p & BTUI_PROMPT) != 0;
    s->audio = (p >> BTUI_AUDIO_SHIFT) & 7u;
    s->reconnecting = (p & BTUI_RECONNECTING) != 0;
    s->connected = (p & BTUI_CONNECTED) != 0;
    s->power_wanted = (p & BTUI_POWER_WANTED) != 0;
    s->settings_read = (p & BTUI_SETTINGS_READ) != 0;
    s->generation = generation;
    s->problem = problem;
}

const char *btui_sprite(const bt_ui_summary *s)
{
    int busy = s->state == 1 || s->state == 2 || s->state == 4 ||
               s->scanning || s->prompt || s->audio == 1 || s->reconnecting;
    if (s->state == 0 || s->state == 5) return "bt_idle";
    return busy ? "bt_busy" : (s->connected ? "bt_on" : "bt_ready");
}

void btui_read_entry(const uint8_t *e, bt_ui_device *d)
{
    memcpy(d->address, e, 6);
    d->flags = (uint16_t)(e[6] | (e[7] << 8));
    d->address_type = e[9];
    d->link_state = e[13];
    d->battery = e[82];
    memcpy(d->name, e + 16, BTUI_NAME_BYTES - 1);
    d->name[BTUI_NAME_BYTES - 1] = 0;
}

static size_t put(char *out, size_t room, size_t at, const char *text);

void btui_label(const bt_ui_device *d, char *out, size_t room)
{
    static const char hex[] = "0123456789abcdef";
    const char *kind;
    size_t at = 0, i;
    if (room == 0) return;
    if (d->name[0] != 0)
    {
        for (i = 0; d->name[i] != 0 && i + 1 < room; ++i) out[i] = d->name[i];
        out[i] = 0;
        return;
    }
    kind = (d->flags & BTUI_DEV_KEYBOARD) ? "Keyboard" :
           (d->flags & BTUI_DEV_MOUSE) ? "Mouse" :
           (d->flags & BTUI_DEV_GAMEPAD) ? "Game controller" :
           (d->flags & (BTUI_DEV_AUDIO_SINK | BTUI_DEV_HANDSFREE)) ?
               "Audio device" :
           (d->flags & BTUI_DEV_HID) ? "Input device" :
           (d->flags & BTUI_DEV_LE) ? "Bluetooth LE device" :
           "Bluetooth device";
    at = put(out, room, at, kind);
    at = put(out, room, at, " ");
    for (i = 6; i-- > 0;)
    {
        char two[4];
        two[0] = hex[d->address[i] >> 4];
        two[1] = hex[d->address[i] & 15];
        two[2] = i != 0 ? ':' : 0;
        two[3] = 0;
        at = put(out, room, at, two);
    }
}

unsigned int btui_profile_for(const bt_ui_device *d)
{
    if (d->flags & BTUI_DEV_LE) return 3;
    if ((d->flags & BTUI_DEV_AUDIO_SINK) && !(d->flags & BTUI_DEV_HID)) return 1;
    return 2;
}

static size_t put(char *out, size_t room, size_t at, const char *text)
{
    while (*text != 0 && at + 1 < room) out[at++] = *text++;
    out[at < room ? at : room - 1] = 0;
    return at;
}

size_t btui_devices_description(const bt_ui_device *d, size_t count,
                                size_t max, const char *none, char *out,
                                size_t room)
{
    size_t i, at = 0, n = 0;
    if (room == 0) return 0;
    out[0] = 0;
    if (count == 0)
    {
        at = put(out, room, at, "~\"");
        at = put(out, room, at, none);
        (void)put(out, room, at, "\"");
        return 1;
    }
    for (i = 0; i < count && n < max; ++i)
    {
        char shown[BTUI_NAME_BYTES + 32];
        const char *name = shown;
        char clean[BTUI_NAME_BYTES + 32];
        size_t k;
        btui_label(&d[i], shown, sizeof shown);
        for (k = 0; k + 1 < sizeof clean && name[k] != 0; ++k)
            clean[k] = (name[k] == '"' || name[k] == ',') ? ' ' : name[k];
        clean[k] = 0;
        if (n != 0) at = put(out, room, at, ",");
        at = put(out, room, at, "\"");
        at = put(out, room, at, clean);
        if (d[i].battery <= 100 && (d[i].flags & BTUI_DEV_CONNECTED))
        {
            /* " 83%": the level of a connected device that reports it. */
            char level[8];
            unsigned int v = d[i].battery, m = 0;
            level[m++] = ' ';
            if (v >= 100) { level[m++] = '1'; level[m++] = '0'; level[m++] = '0'; }
            else
            {
                if (v >= 10) level[m++] = (char)('0' + v / 10);
                level[m++] = (char)('0' + v % 10);
            }
            level[m++] = '%';
            level[m] = 0;
            at = put(out, room, at, level);
        }
        at = put(out, room, at, "\"");
        ++n;
    }
    return n;
}

void btui_message_changed(uint32_t block[7], uint32_t generation,
                          uint32_t flags)
{
    memset(block, 0, 7 * sizeof block[0]);
    block[0] = BTUI_MESSAGE_BYTES;
    block[4] = BTUI_MESSAGE_CHANGED;
    block[5] = generation;
    block[6] = flags;
}

void btui_config_defaults(bt_ui_config *c)
{
    c->power = 0;
    c->start = 1;
    c->discoverable = 0;
    c->reconnect = 1;
    c->output = 0;
    c->idle = BTUI_IDLE_DEFAULT;
}

int btui_config_line(const char *line, bt_ui_config *c)
{
    if (strncmp(line, "Power=", 6) == 0) c->power = line[6] == '1';
    else if (strncmp(line, "Start=", 6) == 0) c->start = line[6] == '1';
    else if (strncmp(line, "Discoverable=", 13) == 0)
        c->discoverable = line[13] == '1';
    else if (strncmp(line, "Reconnect=", 10) == 0) c->reconnect = line[10] == '1';
    else if (strncmp(line, "Output=", 7) == 0) c->output = line[7] == '1';
    else if (strncmp(line, "Idle=", 5) == 0)
    {
        int v = 0;
        const char *p = line + 5;
        while (*p >= '0' && *p <= '9' && v < 10000) v = v * 10 + (*p++ - '0');
        c->idle = v;
    }
    else return 0;
    return 1;
}

size_t btui_config_text(const bt_ui_config *c, char *out, size_t room)
{
    static const char *keys[5] = { "Power", "Start", "Discoverable",
                                   "Reconnect", "Output" };
    const int values[5] = { c->power != 0, c->start != 0,
                            c->discoverable != 0, c->reconnect != 0,
                            c->output != 0 };
    size_t at = 0, i;
    for (i = 0; i < 5; ++i)
    {
        const char *k = keys[i];
        while (*k != 0 && at + 4 < room) out[at++] = *k++;
        if (at + 4 >= room) break;
        out[at++] = '=';
        out[at++] = (char)('0' + values[i]);
        out[at++] = '\n';
    }
    if (c->idle != BTUI_IDLE_DEFAULT && at + 16 < room)
    {
        char digits[8];
        int n = 0, v = c->idle < 0 ? 0 : c->idle > 9999 ? 9999 : c->idle;
        memcpy(out + at, "Idle=", 5);
        at += 5;
        do { digits[n++] = (char)('0' + v % 10); v /= 10; } while (v != 0);
        while (n > 0) out[at++] = digits[--n];
        out[at++] = '\n';
    }
    if (at < room) out[at] = 0;
    return at;
}

static unsigned int hex_digit(char c)
{
    if (c >= '0' && c <= '9') return (unsigned int)(c - '0');
    if (c >= 'a' && c <= 'f') return (unsigned int)(c - 'a' + 10);
    if (c >= 'A' && c <= 'F') return (unsigned int)(c - 'A' + 10);
    return 16;
}

size_t btui_parse_address(const char *t, uint8_t raw[6])
{
    unsigned int i;
    for (i = 0; i < 6; ++i)
    {
        unsigned int hi = hex_digit(t[i * 3]), lo = hex_digit(t[i * 3 + 1]);
        if (hi > 15 || lo > 15) return 0;
        if (i < 5 && t[i * 3 + 2] != ':') return 0;
        raw[5 - i] = (uint8_t)(hi << 4 | lo);
    }
    return 17;
}

unsigned int btui_button_line(const char *line, char *path, size_t room)
{
    unsigned int button = 0;
    size_t n;
    while (*line == ' ') ++line;
    if (*line < '0' || *line > '9') return 0;
    while (*line >= '0' && *line <= '9')
        button = button * 10 + (unsigned int)(*line++ - '0');
    if (button < 4 || button > 32 || *line != ' ') return 0;
    while (*line == ' ') ++line;
    n = strlen(line);
    while (n > 0 && (line[n - 1] == '\n' || line[n - 1] == '\r' ||
                     line[n - 1] == ' '))
        --n;
    if (n == 0 || n + 1 > room || (n == 4 && strncmp(line, "None", 4) == 0))
        return 0;
    memcpy(path, line, n);
    path[n] = 0;
    return button;
}

static size_t join(char *out, size_t room, const char *a, const char *b)
{
    size_t n = strlen(a), m = strlen(b);
    if (n + m + 1 > room) { if (room) out[0] = 0; return 0; }
    memcpy(out, a, n);
    memcpy(out + n, b, m + 1);
    return n + m;
}

size_t btui_read_path(const char *leaf, char *out, size_t room)
{
    char tmp[64];
    if (join(tmp, sizeof tmp, "Choices:Bluetooth.", leaf) == 0) return 0;
    return join(out, room, tmp, "");
}

size_t btui_write_path(const char *leaf, char *out, size_t room)
{
    char tmp[64];
    if (join(tmp, sizeof tmp, "<Choices$Write>.Bluetooth.", leaf) == 0) return 0;
    return join(out, room, tmp, "");
}

size_t btui_write_dir(char *out, size_t room)
{
    return join(out, room, "<Choices$Write>.Bluetooth", "");
}

int btui_settings_due(bt_ui_settings_poll *p, uint32_t now)
{
    if (p->done) return 0;
    if (!p->forced && p->checked &&
        (uint32_t)(now - p->last_check) < BTUI_SETTINGS_INTERVAL_MS)
        return 0;
    p->checked = 1;
    p->last_check = now;
    return 1;
}

int btui_settings_decide(bt_ui_settings_poll *p, int path_set)
{
    if (p->done) return 0;
    if (!path_set && !p->forced) return 0;
    p->done = 1;
    return 1;
}

int32_t btui_volume_to_gain(unsigned int volume)
{
    if (volume > 127u) volume = 127u;
    /* -768 * (127 - volume) / 127, rounded to the nearest unit. */
    return -(int32_t)((768u * (127u - volume) + 63u) / 127u);
}

unsigned int btui_gain_to_volume(int32_t gain)
{
    int32_t v;
    if (gain >= 0) return 127u;
    if (gain <= BTUI_GAIN_MIN) return 0;
    /* 127 + gain * 127 / 768, rounded. */
    v = 127 - (int32_t)(((uint32_t)(-gain) * 127u + 384u) / 768u);
    return v < 0 ? 0u : (unsigned int)v;
}
