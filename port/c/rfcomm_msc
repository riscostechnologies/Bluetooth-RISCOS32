/* Explicit MSC exchange adapted from NetBSD rfcomm_dlc_open/recv_mcc_msc. */
#include "rfcomm_msc.h"
#include <string.h>

void btv_rfcomm_msc_init(btv_rfcomm_msc *msc)
{
    if (msc != NULL)
        memset(msc, 0, sizeof(*msc));
}

int btv_rfcomm_msc_ready(const btv_rfcomm_msc *msc)
{
    return msc != NULL && msc->active && !msc->failed && msc->own_acked && msc->peer_acked;
}

static void request(btv_rfcomm_msc *msc, uint8_t modem, uint32_t now)
{
    uint8_t parameters[2];
    parameters[0] = (uint8_t)((msc->dlci << 2) | 3);
    parameters[1] = modem | 1;
    msc->local_modem = modem;
    msc->own_sent = msc->own_acked = 0;
    msc->started = now;
    msc->request_bytes = btv_rfcomm_mcc_encode(msc->request, 4, 0x38, 1, parameters, 2);
}

int btv_rfcomm_msc_start(btv_rfcomm_msc *msc, uint8_t dlci, uint8_t modem, uint32_t now)
{
    if (msc == NULL || msc->active || dlci < 2 || dlci > 61 || (modem & ~0xceU))
        return 0;
    msc->active = 1;
    msc->dlci = dlci;
    request(msc, modem, now);
    return 1;
}

int btv_rfcomm_msc_update(btv_rfcomm_msc *msc, uint8_t modem, uint32_t now)
{
    if (!btv_rfcomm_msc_ready(msc) || msc->response_bytes != 0 || (modem & ~0xceU))
        return 0;
    request(msc, modem, now);
    return 1;
}

static int fail(btv_rfcomm_msc *msc)
{
    msc->failed = 1;
    msc->request_bytes = msc->response_bytes = 0;
    return -1;
}

void btv_rfcomm_msc_tick(btv_rfcomm_msc *msc, uint32_t now)
{
    if (msc != NULL && msc->active && !msc->failed && !btv_rfcomm_msc_ready(msc) &&
        (uint32_t)(now - msc->started) >= 20000UL)
        fail(msc);
}

size_t btv_rfcomm_msc_output(btv_rfcomm_msc *msc, uint8_t *output,
                             size_t capacity, unsigned int *token, uint32_t now)
{
    size_t bytes;
    if (msc == NULL || output == NULL || token == NULL)
        return 0;
    btv_rfcomm_msc_tick(msc, now);
    bytes = msc->response_bytes ? msc->response_bytes : msc->request_bytes;
    if (!msc->active || msc->failed || bytes == 0 || capacity < bytes)
        return 0;
    *token = msc->response_bytes ? 2 : 1;
    memcpy(output, *token == 2 ? msc->response : msc->request, bytes);
    return bytes;
}

int btv_rfcomm_msc_sent(btv_rfcomm_msc *msc, unsigned int token)
{
    if (msc == NULL || !msc->active || msc->failed)
        return 0;
    if (token == 2 && msc->response_bytes)
    {
        msc->response_bytes = 0;
        msc->peer_acked = 1;
        return 1;
    }
    if (token == 1 && msc->request_bytes && !msc->response_bytes)
    {
        msc->request_bytes = 0;
        msc->own_sent = 1;
        return 1;
    }
    return 0;
}

int btv_rfcomm_msc_receive(btv_rfcomm_msc *msc, const btv_rfcomm_mcc *mcc, uint32_t now)
{
    if (msc == NULL || mcc == NULL)
        return -1;
    btv_rfcomm_msc_tick(msc, now);
    if (msc->failed)
        return -1;
    if (!msc->active || mcc->type != 0x38)
        return 0;
    if (mcc->data == NULL || (mcc->bytes != 2 && mcc->bytes != 3))
        return fail(msc);
    if ((mcc->data[0] >> 2) != msc->dlci)
        return 0;
    if ((mcc->data[0] & 3) != 3 ||
        ((mcc->data[1] & 1) ? mcc->bytes != 2 : (mcc->bytes != 3 || !(mcc->data[2] & 1))))
        return fail(msc);
    if (!mcc->command)
    {
        if (!msc->own_sent || msc->own_acked || mcc->bytes != 2 ||
            mcc->data[1] != (uint8_t)(msc->local_modem | 1))
            return 0;
        msc->own_acked = 1;
        return 1;
    }
    if (msc->response_bytes)
        return 2;
    if (btv_rfcomm_msc_ready(msc))
        msc->started = now;
    msc->peer_acked = 0;
    msc->peer_modem = mcc->data[1] & 0xfe;
    msc->peer_break = mcc->bytes == 3 ? mcc->data[2] : 0;
    msc->response_bytes = btv_rfcomm_mcc_encode(msc->response, 5, 0x38, 0, mcc->data, mcc->bytes);
    return 1;
}
