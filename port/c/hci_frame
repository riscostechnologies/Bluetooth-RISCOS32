/*******************************************************************
 * File:        hci_frame
 * Purpose:     USB HCI lengths and command encoding.
 * Reference:   NetBSD hci.h packet layouts; USB excludes its type octet.
 *              See upstream/manifest.json for the pinned source baseline.
 ******************************************************************/
#include "hci_frame.h"
#include <string.h>

/* Validate the available header and bound the declared payload before use. */
int btv_hci_frame_size(unsigned int type, const uint8_t *data, size_t bytes,
                        size_t maximum_payload, size_t *frame_bytes)
{
    size_t header, payload;
    if (frame_bytes == NULL)
        return BTV_HCI_INVALID;
    *frame_bytes = 0;
    switch (type)
    {
        case BTV_HCI_COMMAND:
        case BTV_HCI_SCO: header = 3; break;
        case BTV_HCI_ACL: header = 4; break;
        case BTV_HCI_EVENT: header = 2; break;
        default: return BTV_HCI_INVALID;
    }
    if (data == NULL && bytes != 0)
        return BTV_HCI_INVALID;
    if (bytes < header)
        return BTV_HCI_MORE;
    if (type == BTV_HCI_ACL)
        payload = (size_t)data[2] | ((size_t)data[3] << 8);
    else
        payload = data[header - 1];
    if (payload > maximum_payload)
        return BTV_HCI_INVALID;
    *frame_bytes = header + payload;
    return bytes < *frame_bytes ? BTV_HCI_MORE : BTV_HCI_COMPLETE;
}

/* Encode opcode and parameter size only after validating every input. */
size_t btv_hci_command(uint8_t *output, size_t capacity, uint16_t opcode,
                       const uint8_t *parameters, size_t parameter_bytes)
{
    if (output == NULL || parameter_bytes > 255 ||
        (parameters == NULL && parameter_bytes != 0) ||
        capacity < parameter_bytes + 3)
        return 0;
    /* Parameters may overlap the output buffer. Move them before the header. */
    if (parameter_bytes != 0)
        memmove(output + 3, parameters, parameter_bytes);
    output[0] = (uint8_t)opcode;
    output[1] = (uint8_t)(opcode >> 8);
    output[2] = (uint8_t)parameter_bytes;
    return parameter_bytes + 3;
}
