#ifndef BTV_L2CAP_SIGNAL_H
#define BTV_L2CAP_SIGNAL_H
#include <stddef.h>
#include <stdint.h>

typedef struct btv_l2cap_signal
{
    const uint8_t *data;
    size_t bytes, offset;
} btv_l2cap_signal;

typedef struct btv_l2cap_command
{
    uint8_t code, identifier;
    const uint8_t *parameters;
    size_t bytes;
} btv_l2cap_command;

/* Validate an entire reassembled classic signaling PDU (including the four
 * byte L2CAP header) before exposing any commands. Unknown command codes are
 * retained for the owner's Command Reject handling. Input remains caller
 * owned and must not change until iteration ends. Output unchanged on error.
 * Returns 1 valid, 0 non-signaling CID, -1 malformed. No channel state changes. */
int btv_l2cap_signal_open(btv_l2cap_signal *signal,
                          const uint8_t *pdu, size_t bytes);
/* Returns 1 command, 0 end, -1 invalid iterator. Output unchanged at end/error. */
int btv_l2cap_signal_next(btv_l2cap_signal *signal,
                          btv_l2cap_command *command);
/* Encode one complete signaling PDU. Unknown codes are permitted. Parameters
 * must be a separate, non-overlapping input buffer. Returns total bytes or 0;
 * output is unchanged on failure. Does not allocate identifiers or queue IO. */
size_t btv_l2cap_signal_encode(uint8_t *output, size_t capacity,
                              uint8_t code, uint8_t identifier,
                              const uint8_t *parameters, size_t bytes);
#endif
