/* Classic HID (Bluetooth HID profile 1.1) transaction headers and boot
 * report IDs as they appear on the interrupt channel in boot mode. */
#define BTV_HID_DATA_INPUT      0xA1u
#define BTV_HID_DATA_OUTPUT     0xA2u
#define BTV_HID_BOOT_KEYBOARD   1u
#define BTV_HID_BOOT_MOUSE      2u

/* Where the events go.  The same shape serves the keyboard (key only) and
 * the mouse (key for buttons, pointer, wheel); unused members may be NULL.
 * key:     KeyV KeyDown (down != 0) or KeyUp, with a BTV_KEY_* number.
 * pointer: relative move in RISC OS sense (x right, y UP), unscaled, as
 *          for PointerReason_Report.
 * wheel:   PointerReason_WheelChange: dz negative = up/away (kernel
 *          convention), dw positive = right, extra = buttons 4-8 as
 *          bits 0-4 (PointerReason_WheelChange R2). */
typedef struct btv_hid_sink
{
    void *context;
    void (*key)(void *context, int down, unsigned int riscos_key);
    void (*pointer)(void *context, int dx, int dy);
    void (*wheel)(void *context, int dz, int dw, unsigned int extra);
    /* A mapped extra button went down (button number, 4 and up). Only
     * called for buttons set in the mouse's `mapped` mask. */
    void (*launch)(void *context, unsigned int button);
} btv_hid_sink;

typedef struct btv_hid_keyboard
{
    uint8_t last[8];  /* previous accepted report (modifiers, 0, keys) */
    uint8_t down[16]; /* non-modifier key numbers < 128 reported down */
} btv_hid_keyboard;

#define BTV_HID_MOUSE_PAN_BYTE4 1u /* report byte 4 is AC Pan */

/* How a report-mode mouse's motion and wheel are turned into RISC OS
 * pointer movement. The kernel applies the configured mouse speed
 * (Configure > Mouse, CMOS MouseStep, OS_Word 21,1) to every PointerV
 * report, USB and Bluetooth alike, so that is not done here; what is done
 * here is the part a high-resolution mouse needs: a scale for its counts,
 * a gentle acceleration, and the fractions of a pixel kept between reports
 * so that slow movement is not lost. */
typedef struct btv_hid_mouse_options
{
    int32_t scale_q8;   /* 256 = 1.0: counts to RISC OS units */
    uint8_t accel;      /* gentle acceleration on */
    uint8_t natural;    /* wheel direction reversed */
    uint8_t hscroll;    /* horizontal scroll (AC Pan) on */
    uint8_t pad;
    int32_t wheel_unit; /* wheel counts to a notch (1: already notches) */
    uint32_t mapped;    /* bit n: button n+1 (4 and up) starts an application
                           and is not passed on as a click */
} btv_hid_mouse_options;

typedef struct btv_hid_mouse
{
    uint8_t buttons;  /* byte 0 of the previous report */
    uint8_t flags;    /* BTV_HID_MOUSE_* ; init leaves 0 */
    btv_hid_mouse_options opt;
    int32_t rem_x, rem_y, rem_wheel, rem_pan;   /* what has not been sent */
    uint32_t down_mapped;                       /* mapped buttons held */
    uint32_t options_epoch;  /* which reading of the variables `opt` holds */
} btv_hid_mouse;

/* The gain (256 = 1.0) for a report of this size: 1.0 up to 3 counts, rising
 * to 2.0 at 19 and beyond. */
int32_t btv_hid_accel_q8(int32_t counts);
/* d * gain (q8) plus the remainder so far, in whole units; the rest stays in
 * *rem. Truncates towards zero, so a remainder keeps its sign. */
int32_t btv_hid_scale(int32_t d, int32_t gain_q8, int32_t *rem);
/* Counts into whole steps of `unit`, the remainder kept. */
int32_t btv_hid_steps(int32_t counts, int32_t unit, int32_t *rem);

void btv_hid_keyboard_init(btv_hid_keyboard *k);
/* report = boot keyboard input report: modifiers, reserved, 6 keycodes.
 * Shorter reports are ignored; extra bytes are ignored.  A report with
 * keycode[0] == 0x01 (ErrorRollOver) is ignored, as usbkboard does.
 * Emits modifier changes, then new keys down, then keys up. */
void btv_hid_keyboard_report(btv_hid_keyboard *k, const uint8_t *report,
                             size_t bytes, const btv_hid_sink *sink);
/* Key up for everything held, modifiers included (disconnect). */
void btv_hid_keyboard_release_all(btv_hid_keyboard *k,
                                  const btv_hid_sink *sink);
/* Forget what RISC OS was told without emitting anything, so the next
 * report re-sends every held key: use after KeyV_EnableDrivers, which the
 * kernel issues once it has cleared its own key-down table. */
void btv_hid_keyboard_forget(btv_hid_keyboard *k);
/* RISC OS LED flags (KeyV_NotifyLEDState R1) -> boot output report byte. */
uint8_t btv_hid_keyboard_leds(unsigned int riscos_led_flags);
/* HID usage (keyboard page) -> BTV_KEY_*, or -1 when it has none. */
int btv_hid_key_number(unsigned int usage);

void btv_hid_mouse_init(btv_hid_mouse *m);
/* Boot mouse report: buttons, dx, dy[, wheel[, pan]] (3+ bytes; shorter
 * reports are ignored).  Button bit 0 (left) -> LeftMouse = Select,
 * bit 1 (right) -> RightMouse = Adjust, bit 2 (middle) -> CentreMouse =
 * Menu, bits 3-7 -> wheel `extra`.  dy is negated (HID y is down); the
 * wheel is negated (HID wheel positive is away).  Pan is read from byte 4
 * only with BTV_HID_MOUSE_PAN_BYTE4, since boot mode defines no pan. */
void btv_hid_mouse_report(btv_hid_mouse *m, const uint8_t *report,
                          size_t bytes, const btv_hid_sink *sink);
/* The same for a report already decoded (hid_report): HID's sense, y down
 * and wheel positive away; buttons bit n is button n+1, of which the first
 * three become Select, Adjust and Menu and bits 3-7 travel with the wheel. */
void btv_hid_mouse_event(btv_hid_mouse *m, uint32_t buttons, int32_t dx,
                         int32_t dy, int32_t wheel, int32_t pan,
                         const btv_hid_sink *sink);
/* Button up for everything held (disconnect). */
void btv_hid_mouse_release_all(btv_hid_mouse *m, const btv_hid_sink *sink);

/* Classic HID interrupt-channel frame "A1 id payload...": returns the boot
 * report id (1 keyboard, 2 mouse, or any other id) and the payload, or 0
 * when the frame is not an input DATA frame with a report id.  BLE boot
 * report characteristics (0x2A22, 0x2A33) carry the payload alone. */
unsigned int btv_hid_classic_input(const uint8_t *frame, size_t bytes,
                                   const uint8_t **payload,
                                   size_t *payload_bytes);
/* Writes "A2 01 leds" (interrupt-channel output report); returns 3.  BLE
 * writes the single LED byte to Boot Keyboard Output Report (0x2A32). */
size_t btv_hid_classic_led_frame(uint8_t *frame, uint8_t leds);

#endif
