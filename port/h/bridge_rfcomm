#ifndef BTV_BRIDGE_RFCOMM_H
#define BTV_BRIDGE_RFCOMM_H
#include "bridge_acl.h"
#include "l2cap_dispatch.h"
#include "rfcomm_l2cap.h"

enum btv_bridge_rfcomm_state
{
    BTV_BR_IDLE, BTV_BR_OPENING, BTV_BR_NEGOTIATING, BTV_BR_READY,
    BTV_BR_CLOSING, BTV_BR_DONE, BTV_BR_FAILED
};

typedef struct btv_bridge_rfcomm
{
    btv_bridge_acl *acl;
    btv_l2cap_dispatch *dispatch;
    btv_rfcomm_l2cap binding;
    uint16_t local_cid;
    uint8_t output[BTV_L2CAP_SIGNAL_MTU + 4];
    unsigned int output_owner, output_token, state, error;
    uint8_t disconnect_requested;
} btv_bridge_rfcomm;

int btv_bridge_rfcomm_start(btv_bridge_rfcomm *bridge, btv_bridge_acl *acl,
                            btv_l2cap_dispatch *dispatch,
                            uint8_t server_channel, uint32_t now);
int btv_bridge_rfcomm_pump(btv_bridge_rfcomm *bridge, uint32_t now);
int btv_bridge_rfcomm_write(btv_bridge_rfcomm *bridge,
                            const uint8_t *data, size_t bytes);
size_t btv_bridge_rfcomm_read(btv_bridge_rfcomm *bridge,
                              uint8_t *data, size_t capacity);
int btv_bridge_rfcomm_close(btv_bridge_rfcomm *bridge, uint32_t now);

#endif
