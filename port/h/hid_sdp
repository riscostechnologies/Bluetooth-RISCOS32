/*******************************************************************
 * File:        hid_sdp
 * Purpose:     What a classic HID device's SDP record says that the host
 *              needs: its HID report descriptor (attribute 0x0206,
 *              HIDDescriptorList), whether it has a boot mode (0x020E,
 *              HIDBootDevice), its subclass (0x0202) and whether it
 *              reconnects by itself (0x0205 HIDReconnectInitiate) or is
 *              normally connected (0x020D).  Pure.
 * Reference:   Bluetooth HID Profile 1.1.1, section 5.3 (the attribute
 *              ids and the descriptor list's shape: a sequence of
 *              sequences of ClassDescriptorType 0x22 and the descriptor as
 *              a string).  USB HID 1.11 for the descriptor itself.
 * Licence:     BSD-2-Clause (see LICENSE).
 ******************************************************************/
#ifndef BTV_HID_SDP_H
#define BTV_HID_SDP_H

#include <stddef.h>
#include <stdint.h>

#define BTV_HIDSDP_UUID 0x1124u           /* Human Interface Device Service */
#define BTV_HIDSDP_SUBCLASS 0x0202u
#define BTV_HIDSDP_RECONNECT 0x0205u
#define BTV_HIDSDP_DESCRIPTORS 0x0206u
#define BTV_HIDSDP_NORMALLY_CONNECTABLE 0x020du
#define BTV_HIDSDP_BOOT 0x020eu

typedef struct btv_hid_sdp_info
{
    const uint8_t *descriptor;     /* borrowed from the result */
    size_t descriptor_bytes;
    uint8_t boot_known, boot_device;
    uint8_t subclass_known, subclass;
    uint8_t reconnect_known, reconnect_initiate;
} btv_hid_sdp_info;

/* The result of a ServiceSearchAttribute for the HID UUID (a sequence of
 * attribute lists).  Returns 1 when a record with a report descriptor was
 * found (the first one), 0 when there is none, -1 when it is malformed. */
int btv_hid_sdp_parse(const uint8_t *result, size_t bytes,
                      btv_hid_sdp_info *info);

#endif
