/*******************************************************************
 * File:        bt_hid
 * Purpose:     Classic Bluetooth HID host (boot protocol keyboards and
 *              mice) over the Bluetooth core.
 ******************************************************************/
#ifndef BTP_HID_H
#define BTP_HID_H

#include <stddef.h>
#include <stdint.h>
#include "hid_input.h"
#include "hid_report.h"
#include "hid_extras.h"
#include "hid_pad.h"

enum btp_hid_state
{
    BTP_HID_IDLE, BTP_HID_SECURING, BTP_HID_CONTROL, BTP_HID_INTERRUPT,
    BTP_HID_WAITING, BTP_HID_READY, BTP_HID_FAILED,
    BTP_HID_SDP                    /* reading the device's descriptor */
};

typedef struct btp_hid
{
    uint8_t active, state, link;
    int control, interrupt;
    uint8_t keyboard, mouse, protocol_set;
    uint8_t leds;
    uint32_t step_started, reports;
    btv_hid_keyboard kb;
    btv_hid_mouse pointer;
    /* Report protocol, from the device's own descriptor (SDP). */
    uint8_t sdp, report_mode, ids_used, pad_attached, outgoing;
    uint8_t has_leds, led_id;
    uint16_t last_consumer[BTV_XCONSUMER_MAX];
    btv_hid_map map;
    btv_hid_extras extras;
    btv_hid_pad pad;
    /* What happened, for *BTInfo (bt_hid.c): where the protocol came from,
     * the device's answer to SET_PROTOCOL, and what became of its reports. */
    uint8_t awaiting_handshake, handshake, from_cache, fell_back, attach_failed;
    uint8_t last_report_id, last_report_bytes, boot_after_handshake, boot_capable;
    uint32_t decoded, unmatched, fallbacks;
} btp_hid;

/* h->sdp */
enum { BTP_HID_SDP_NONE, BTP_HID_SDP_RUNNING, BTP_HID_SDP_DONE, BTP_HID_SDP_FAILED };

#endif
