/*******************************************************************
 * File:        usb_stream_path
 * Purpose:     Build validated RISC OS USBDriver DeviceFS paths.
 ******************************************************************/
#ifndef BTV_USB_STREAM_PATH_H
#define BTV_USB_STREAM_PATH_H
#include <stddef.h>
#include <stdint.h>

enum btv_usb_stream_kind
{
    BTV_USB_STREAM_BULK,
    BTV_USB_STREAM_INTERRUPT,
    BTV_USB_STREAM_ISOCHRONOUS
};

/* The output is unchanged on failure. DeviceFS special fields are separated
 * by semicolons; a slash is a normal filename character, not a separator. */
int btv_usb_stream_path(char *output, size_t capacity, const char *device,
                        uint8_t interface_number, uint8_t alternate,
                        uint8_t endpoint, enum btv_usb_stream_kind kind,
                        size_t buffer_bytes, int nopad);

/* Isochronous stream for USBDriver 1.35 (Colin Granville's isochronous
 * API): paced at packet_bytes per 1 ms frame via samplerate/samplesize,
 * with nopad so output is never padded with silence (a Bluetooth SCO byte
 * stream would be misframed by it). */
int btv_usb_isoc_stream_path(char *output, size_t capacity, const char *device,
                             uint8_t interface_number, uint8_t alternate,
                             uint8_t endpoint, size_t buffer_bytes,
                             uint16_t packet_bytes);

#endif
