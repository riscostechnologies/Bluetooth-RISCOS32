#ifndef BTV_RFCOMM_CREDIT_H
#define BTV_RFCOMM_CREDIT_H
#include <stddef.h>
#include <stdint.h>
typedef struct btv_rfcomm_credit
{
    uint16_t mtu, slots, occupied, receive_outstanding, transmit_available;
    unsigned int active, failed;
} btv_rfcomm_credit;
/* Credit-mode DLC only, initialized from successful PN once. slots counts
 * caller-owned MTU-sized receive buffers. Initial receive credits were already
 * advertised by PN and therefore reserve slots, even before data arrives.
 * Serialized owner; fresh init requires draining the old DLC and physical IO. */
int btv_rfcomm_credit_init(btv_rfcomm_credit *credit, uint16_t mtu,
                           uint16_t slots, uint8_t initial_receive, uint8_t initial_transmit);
/* Available grant without mutation (maximum one credit octet). */
unsigned int btv_rfcomm_credit_grant(const btv_rfcomm_credit *credit);
/* Preview outgoing UIH information bytes and piggyback/standalone grant.
 * Returns 1 permitted, 0 wait/invalid, -1 failed. Zero-byte credit-only frames
 * do not consume transmit credit. Frame/L2CAP MTU overhead remains owner-owned. */
int btv_rfcomm_credit_can_send(const btv_rfcomm_credit *credit, size_t bytes, unsigned int grant);
/* Commit immediately after ordered TX acceptance of copied frame. A failed
 * submission commits nothing; later physical failure requires abort/recovery. */
int btv_rfcomm_credit_sent(btv_rfcomm_credit *credit, size_t bytes, unsigned int grant);
/* Complete, validated UIH data for this OPEN DLC. Owner must be able to copy
 * nonempty data into one of the reserved slots before returning to its event
 * loop. A credit octet (0 if absent) and data consumption apply atomically.
 * Returns 1 accepted or -1 violation; failure freezes without changing counts. */
int btv_rfcomm_credit_received(btv_rfcomm_credit *credit, size_t bytes, unsigned int grant);
/* Release exactly the packet slots whose payloads the consumer has finished.
 * Partial byte reads do not release a slot. Does not automatically grant them. */
int btv_rfcomm_credit_release(btv_rfcomm_credit *credit, unsigned int packets);
void btv_rfcomm_credit_abort(btv_rfcomm_credit *credit);
#endif
