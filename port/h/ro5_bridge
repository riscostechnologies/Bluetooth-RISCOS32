/*
 * Built-in BCM4345C0 transport for Raspberry Pi 4, Pi 400 and CM4 running
 * 32-bit RISC OS 5. This has the same packet contract as uart_bridge, but
 * is kept distinct so it can coexist with the Pinebook Pro backend.
 */
#ifndef BTV_RO5_BRIDGE_H
#define BTV_RO5_BRIDGE_H

#include <stdint.h>
#include "host_bridge.h"

int btv_ro5_inspect(void);
int btv_ro5_open(void);
int btv_ro5_boot(void);
int btv_ro5_submit(unsigned int kind, const uint8_t *data, uint32_t bytes,
                   uint32_t *ticket);
int btv_ro5_poll(uint32_t ticket, btv_host_bridge_completion *completion);
int btv_ro5_cancel(uint32_t ticket);
int btv_ro5_close(void);
int btv_ro5_is_open(void);
void btv_ro5_counts(uint32_t *in_count, uint32_t *out_count);
void btv_ro5_stats(uint32_t *tx_waiting, uint32_t *rx_total,
                   uint32_t *rx_lost);

/* Supplied by the module: a malloc'd Firmware leaf, or NULL when absent. */
const uint8_t *btm_firmware_load(const char *leaf, uint32_t *bytes);
void btm_firmware_free(const uint8_t *data);

#endif
